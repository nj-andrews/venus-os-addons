	local stdout
	stdout="$(run_scheduler_case state_updates_on_enabled_change 2>&1)"
	assert_exitcode 0 "schedule state bitmask should track enabled flags"
	assert_eq "ok" "$stdout" "state bitmask scenario returns ok"
