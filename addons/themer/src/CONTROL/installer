#!/usr/bin/env bash
# shellcheck disable=SC2034

# USER EDITABLE SECTION
# Copy this file as the minimal skeleton for a new install that uses Vespera.
# Only the settings below are intended to be customized by package authors.
# Everything else is managed by the shared installer runtime.

# Valid callbacks
# pre_remove
# post_remove
# finalize_remove - called after opkg has finished
#
# pre_install
# post_install
# finalize_install - called after opkg has finished
#
# Valid $PACKAGE_ACTION values
# install|upgrade-install|configure|dev-install
# remove|upgrade-remove|dev-remove

PACKAGE_DBUS_NAME="Themer"
PACKAGE_CUSTOM_MENUS="PageSettingsDisplay/ThemerPageSettingsSubMenu"

# Optional package-level app settings (JSON entries for dbus-lib add_settings)
PACKAGE_DBUS_SETTINGS='
		{"path":"/Settings/Themer/AvailableThemes", "default":"Dark"}
	  {"path":"/Settings/Themer/CurrentTheme", "default":""}
		{"path":"/Settings/Themer/Themes/Dark/TextColor", "default":"#ffffff"}
		{"path":"/Settings/Themer/Themes/Dark/WindowBackgroundColor", "default":"#202020"}
		{"path":"/Settings/Themer/Themes/Dark/BackgroundColor", "default":"#202020"}
		{"path":"/Settings/Themer/Themes/Dark/BackgroundColorSelected", "default":"#4790d0"}
		{"path":"/Settings/Themer/Themes/Dark/BackgroundColor2", "default":"#313131"}
		{"path":"/Settings/Themer/Themes/Dark/IconSuffixNormal", "default":"-active"}
		{"path":"/Settings/Themer/Themes/Dark/IconSuffixSelected", "default":"-active"}
		{"path":"/Settings/Themer/Themes/Dark/BorderColor", "default":"#3c3c3c"}
		{"path":"/Settings/Themer/Themes/Dark/ServiceBackgroundColor", "default":"#b07c04"}
		{"path":"/Settings/Themer/Themes/Dark/BackgroundColorSelected", "default":"#2969a1"}
		{"path":"/Settings/Themer/Themes/Dark/BackgroundTankColor", "default":"#cccccc"}
		{"path":"/Settings/Themer/Themes/Dark/BackgroundTankColor", "default":"#cccccc"}
		{"path":"/Settings/Themer/Themes/Dark/Color2", "default":"#c4c4c4"}
'

DBUS_AVAILABLE_THEMES="Dark" # space separated list of themes

pre_install() {
	local dbus_path="/Settings/Themer/AvailableThemes"
	# 1. add themes to cvs list
	dbus_lib_update_csv_items "$dbus_path" "add" "${DBUS_AVAILABLE_THEMES[@]}"
}

pre_remove() {
	installer_lib_is_upgrade && return

	local dbus_path

	# 1. remove themes from existing cvs list
	dbus_path="/Settings/Themer/AvailableThemes"
	dbus_lib_update_csv_items "$dbus_path" "remove" "${DBUS_AVAILABLE_THEMES[@]}"

  dbus_lib_get_value "$dbus_path" csv_values '' || true
	if [[ -z "$csv_values" ]]; then
		  dbus -y com.victronenergy.settings / RemoveSettings "%[ '$dbus_path' ]" &> /dev/null
	fi
}
