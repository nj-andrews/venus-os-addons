#!/bin/bash

set -o nounset

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1

echo building /feeds/venus-data-vespera-blind-install.tgz
# vespera-bootstrap is stored next to blind-install.sh (rc/) in the archive
tar czf "../../../../feeds/release/vespera/venus-data-vespera-blind-install.tgz" \
	-C "src/" rc \
	--transform 's,^vespera-bootstrap$,rc/vespera-bootstrap,' \
	-C "../../../../../feeds" vespera-bootstrap

echo "done"