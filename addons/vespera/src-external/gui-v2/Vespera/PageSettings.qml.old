import QtQuick 2
import Victron.VenusOS

Page {
	id: root

	required property var vesperaManager

	GradientListView {
		id: settingsListView

		model: VisibleItemModel {
			ListSwitch {
				dataItem.uid: root.vesperaManager.showCompactSetting.uid
				//% "Show Compact"
				text: qsTrId("vespera_show_compact")
			}
			ListSwitch {
				dataItem.uid: root.vesperaManager.noActionSetting.uid
				//% "No Action"
				text: qsTrId("vespera_no_action")
			}
		}
	}
}
