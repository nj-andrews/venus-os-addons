#!/bin/bash

# /data/vespera/overlay-lib
# Core overlay management functions for Vespera
#
# Behavior summary:
# - One app can register multiple target paths.
# - Multiple apps can register the same target path.
# - A shared target uses one runtime overlay mount keyed by target path.
# - Overlay precedence is "last registered wins" for conflicting files.
# - Unregister remounts shared targets and only fully unmounts when no apps remain.
# - Runtime directories are always prepared as:
#   /data/apps/available/vespera/overlays/<target-id>/{kernel-work,upper,merged}
#
# Path resolution (see __overlay_lib_validate):
# - Paths in vespera.installer-overlays are "master" paths. They are always
#   used, whether vespera is enabled or disabled.
# - A requested path inside a master (or inside a target already installed by
#   another app) resolves to that master/target, so apps share one mount.
# - A requested path that is a parent of a master, or a parent of a target
#   installed by another app, is rejected. So is "/" and any relative path.
# - Resolutions are pinned in installed.conf at install time and are not
#   recomputed, so an app keeps its mount when another app is uninstalled.
# - Paths are compared per path component: /opt/victronenergy2 is NOT inside
#   /opt/victronenergy.
# - Validation is all-or-nothing: if any path is rejected, nothing is registered.
#
# Config formats:
#   OVERLAY_CONF_FILE (enabled apps, resolved targets):  app_name|<target>
#   installed.conf (all installed apps, enabled or not): app_name|<requested>|<resolved>
#
# Commands:
#   overlay-check <app> < overlays    validate only (no changes)
#   overlay-register <app> < overlays validate, pin, and mount (enable/install)
#   overlay-unregister [app]          unmount/remove from OVERLAY_CONF_FILE (disable)
#   overlay-uninstall [app]           unregister and forget the pinned installation

OVERLAY_BASE_DIR="/data/var/vespera/overlays"
OVERLAY_CONF_FILE="${OVERLAY_BASE_DIR}/overlays.conf"
OVERLAY_WORK_DIRNAME="kernel-work" #use kernel-work; will produce kernel-work/work
OVERLAY_UPPER_DIRNAME="upper"
OVERLAY_MERGED_DIRNAME="merged"
OVERLAY_MASTER_APP="vespera"

# Ensure base runtime directories exist
__overlay_lib_init() {
	[[ -f "$OVERLAY_CONF_FILE" ]] && return 0

	mkdir -p "$OVERLAY_BASE_DIR"
	touch "$OVERLAY_CONF_FILE"
}

__overlay_lib_installed_file() {
	echo "${OVERLAY_BASE_DIR}/installed.conf"
}

__overlay_lib_master_file() {
	echo "${OVERLAY_MASTER_FILE:-${VESPERA_ROOT:-}/data/var/vespera/info/${OVERLAY_MASTER_APP}.installer-overlays}"
}

__overlay_lib_trim() {
	local value="$1"
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	echo "$value"
}

# Print an absolute path without empty/"." components, or fail for relative
# paths, "/" and paths containing "..".
__overlay_lib_normalize_path() {
	local path="$1" part out=""
	local -a parts=()

	[[ "$path" == /* ]] || return 1
	IFS=/ read -r -a parts <<< "$path"
	for part in ${parts[@]+"${parts[@]}"}; do
		case "$part" in
			''|.) continue;;
			..) return 1;;
		esac
		out+="/$part"
	done
	[[ -n "$out" ]] || return 1
	echo "$out"
}

# Succeeds when $1 equals $2 or is below it. Compares whole path components.
__overlay_lib_is_within() {
	[[ "$1" == "$2" || "$1" == "$2"/* ]]
}

# Reads requested overlay paths from stdin and prints "requested|resolved" lines.
# Errors and warnings go to stderr; returns 1 if any path is rejected.
__overlay_lib_validate() {
	local app="$1"
	local installed_file master_file
	local line req resolved t a res rc=0 bad
	local -a masters=()
	local -A pins=() owners=()

	installed_file="$(__overlay_lib_installed_file)"
	master_file="$(__overlay_lib_master_file)"

	if [[ "$app" != "$OVERLAY_MASTER_APP" ]]; then
		if [[ ! -f "$master_file" ]]; then
			echo "ERROR: $app: master overlay file not found: $master_file" >&2
			return 1
		fi
		while IFS= read -r line || [[ -n "$line" ]]; do
			line="$(__overlay_lib_trim "$line")"
			[[ -z "$line" || "$line" == \#* ]] && continue
			t="$(__overlay_lib_normalize_path "$line")" || continue
			masters+=("$t")
		done < "$master_file"
	fi

	if [[ -f "$installed_file" ]]; then
		while IFS='|' read -r a req res; do
			[[ -z "$res" ]] && continue
			if [[ "$a" == "$app" ]]; then
				pins["$req"]="$res"
			elif [[ -z "${owners[$res]+x}" ]]; then
				owners["$res"]="$a"
			fi
		done < "$installed_file"
	fi

	while IFS= read -r line || [[ -n "$line" ]]; do
		line="$(__overlay_lib_trim "$line")"
		[[ -z "$line" || "$line" == \#* ]] && continue

		if ! req="$(__overlay_lib_normalize_path "$line")"; then
			echo "ERROR: $app: invalid overlay path '$line' (must be absolute, not '/', no '..')" >&2
			rc=1
			continue
		fi

		resolved=""
		bad=0
		if [[ "$app" == "$OVERLAY_MASTER_APP" ]]; then
			resolved="$req"
		elif [[ -n "${pins[$req]+x}" ]]; then
			resolved="${pins[$req]}"
		else
			for t in ${masters[@]+"${masters[@]}"}; do
				if __overlay_lib_is_within "$req" "$t"; then resolved="$t"; break; fi
			done
			if [[ -z "$resolved" ]]; then
				for t in ${masters[@]+"${masters[@]}"}; do
					if __overlay_lib_is_within "$t" "$req"; then
						echo "ERROR: $app: overlay '$req' is too broad; it contains protected path '$t'" >&2
						bad=1
						break
					fi
				done
			fi
			if [[ -z "$resolved" && $bad -eq 0 ]]; then
				for t in "${!owners[@]}"; do
					if __overlay_lib_is_within "$req" "$t"; then
						resolved="$t"
						break
					elif __overlay_lib_is_within "$t" "$req"; then
						echo "ERROR: $app: overlay '$req' would hide overlay '$t' owned by ${owners[$t]}" >&2
						bad=1
						break
					fi
				done
			fi
			[[ -z "$resolved" && $bad -eq 0 ]] && resolved="$req"
		fi

		if ((bad)); then
			rc=1
			continue
		fi

		if [[ "$resolved" != "$req" ]] && (( ${VESPERA_VERBOSITY:-1} > 1 )); then
			echo "INFO: $app: overlay '$req' uses '$resolved'" >&2
		fi
		[[ -z "${owners[$resolved]+x}" ]] && owners["$resolved"]="$app"
		echo "$req|$resolved"
	done

	return $rc
}

__overlay_lib_get_runtime_dir() {
	local target_path="$1"
	local mount_id; mount_id="$(echo "$target_path" | tr '/' '_')"
	echo "${OVERLAY_BASE_DIR}/${mount_id}"
}

# Return success when any app still references the target path in the registration state.
__overlay_lib_target_in_use() {
	local target_path="$1"
	local name="" target=""

	[[ ! -f "$OVERLAY_CONF_FILE" ]] && return 1

	while IFS='|' read -r name target; do
		[[ "$name" =~ ^[[:space:]]*(#|$) ]] && continue # skip comments and whitespace
		[[ -z "$target" ]] && continue
		[[ "$target" != "$target_path" ]] && continue
		return 0
	done < "$OVERLAY_CONF_FILE"

	return 1
}

__overlay_lib_prepare_target_dirs() {
	local target_path="$1"
	local mount_runtime_dir; mount_runtime_dir=$(__overlay_lib_get_runtime_dir "$target_path")
	local work_dir="${mount_runtime_dir}/${OVERLAY_WORK_DIRNAME}"
	local upper_dir="${mount_runtime_dir}/${OVERLAY_UPPER_DIRNAME}"
	local merged_dir="${mount_runtime_dir}/${OVERLAY_MERGED_DIRNAME}"

	mkdir -p "$work_dir" "$upper_dir" "$merged_dir"
}

__overlay_lib_list_contains() {
	local value="$1"
	local file="$2"

	grep -F -x "$value" "$file" >/dev/null
}

__overlay_lib_list_all_upper_entries() {
	local overlay_target type
	local relative_path real_path

	[[ ! -f "$OVERLAY_CONF_FILE" ]] && return 0

	while IFS='|' read -r _ target; do
		case "$target" in ''|[[:space:]]*|[[:space:]]#*) continue;; esac # skip whitespace and comments
		overlay_target="$(__overlay_lib_get_runtime_dir "$target")/${OVERLAY_UPPER_DIRNAME}"
		[[ -d "$overlay_target" ]] || continue

		find "$overlay_target" ! -type d |
			while IFS= read -r upper_path; do
				relative_path="${upper_path#"$overlay_target"}"
				real_path="${target%/}${relative_path}"
				[[ -c "$upper_path" ]] && type=W || type=F
				echo "$type|$real_path|$upper_path"
			done
	done < "$OVERLAY_CONF_FILE"
}

overlay_lib_reconcile() {
	local owned_files="$1"
	local whiteouts="$2"
	local reconcile_dir overlay_entries
	local type path upper_path overlay_target

	[[ ! -f "$owned_files" ]] && return 1
	[[ ! -f "$whiteouts" ]] && return 1

	reconcile_dir="$(mktemp -d)" || return 1
	overlay_entries="$reconcile_dir/entries"

	__overlay_lib_list_all_upper_entries > "$overlay_entries"

	while IFS='|' read -r type path upper_path; do
		case "$type" in
			F)
				__overlay_lib_list_contains "$path" "$owned_files" && continue
				rm -f "$upper_path"
				;;
			W)
				__overlay_lib_list_contains "$path" "$whiteouts" && continue
				rm -f "$upper_path"
				;;
		esac
	done < "$overlay_entries"

	# Remove empty directories left behind after deleting stale upper entries.
	while IFS='|' read -r _ target; do
		[[ "$_" =~ ^[[:space:]]*(#|$) ]] && continue # skip comments and whitespace
		overlay_target="$(__overlay_lib_get_runtime_dir "$target")/${OVERLAY_UPPER_DIRNAME}"

		find "$overlay_target" -depth -type d -empty 2>/dev/null |
		while IFS= read -r path; do
			rmdir "$path"
		done
	done < "$OVERLAY_CONF_FILE"

	rm -rf "$reconcile_dir"
}

# Guard against unstable targets (e.g. tmpfs mountpoints like /service).
__overlay_lib_target_supported() {
	local target_path="$1"
	local target_fs_type

	[[ ! -d "$target_path" ]] && {
		echo "WARNING: overlay_lib_target_supported: target does not exist: $target_path" >&1
		return 1
	}

	target_fs_type="$(stat -f -c %T "$target_path" 2>/dev/null)"
	[[ "$target_fs_type" == "tmpfs" ]] && {
		echo "ERROR: overlay_lib_target_supported: tmpfs targets are not supported: $target_path" >&2
		return 1
	}

	return 0
}

__overlay_lib_unmount_target() {
	local target_path="$1"
	local mount_runtime_dir; mount_runtime_dir=$(__overlay_lib_get_runtime_dir "$target_path")
	local merged_dir="${mount_runtime_dir}/${OVERLAY_MERGED_DIRNAME}"

	# Prefer clean unmount first, then fall back to lazy detach when busy.
	if mountpoint -q "$target_path"; then
		umount "$target_path" 2>/dev/null || umount -l "$target_path" 2>/dev/null
	fi
	if mountpoint -q "$merged_dir"; then
		umount "$merged_dir" 2>/dev/null || umount -l "$merged_dir" 2>/dev/null
	fi
}

__overlay_lib_unmount_orphan_runtime_mounts() {
	local merged_mount

	awk '$3 == "overlay" { print $2 }' /proc/self/mounts |
	while IFS= read -r merged_mount; do
		[[ "$merged_mount" == "$OVERLAY_BASE_DIR"/*"/${OVERLAY_MERGED_DIRNAME}" ]] || continue
		umount "$merged_mount" 2>/dev/null || umount -l "$merged_mount" 2>/dev/null
	done
}

__overlay_lib_cleanup_target_dirs() {
	local target_path="${1}"
	local mount_runtime_dir
	mount_runtime_dir=$(__overlay_lib_get_runtime_dir "$target_path")
	local upper_dir="${mount_runtime_dir}/${OVERLAY_UPPER_DIRNAME}"
	local work_dir="${mount_runtime_dir}/${OVERLAY_WORK_DIRNAME}"
	local merged_dir="${mount_runtime_dir}/${OVERLAY_MERGED_DIRNAME}"

	# Do not touch runtime directories while either mountpoint is still active.
	if mountpoint -q "$target_path" || mountpoint -q "$merged_dir"; then
		return 1
	fi

	# Default cleanup: keep upper content, but prune empty runtime dirs.
	# use rm on kernel-work/work to delete left behind
	rm -rf "${work_dir}/work" 2>/dev/null
	rmdir "$work_dir" "$merged_dir" "${mount_runtime_dir}" "$upper_dir" 2>/dev/null || true

}

# Mount/rebuild a shared target mount from current registrations.
# lowerdir order is built so the newest registration has highest precedence.
__overlay_lib_mount_target() {
	local target_path="$1"

	# Rebuild the managed overlay from the current registration state.
	# A managed target is allowed to be mounted while we refresh it; the mounted-path
	# validation is only for new registrations, not for remount/rebuild operations.
	__overlay_lib_unmount_target "$target_path"
	__overlay_lib_target_in_use "$target_path" || return 0
	__overlay_lib_prepare_target_dirs "$target_path"

	local mount_runtime_dir
	mount_runtime_dir=$(__overlay_lib_get_runtime_dir "$target_path")
	local work_dir="${mount_runtime_dir}/${OVERLAY_WORK_DIRNAME}"
	local upper_dir="${mount_runtime_dir}/${OVERLAY_UPPER_DIRNAME}"
	local merged_dir="${mount_runtime_dir}/${OVERLAY_MERGED_DIRNAME}"
	local lowerdirs="$target_path"

	rm -rf "$work_dir"
	mkdir -p "$work_dir" "$merged_dir"

	# 1. Mount OverlayFS to intermediate directory
	mount -t overlay overlay \
		-o "index=off,lowerdir=$lowerdirs,upperdir=$upper_dir,workdir=$work_dir" \
		"$merged_dir" #2>/dev/null

	# 2. Bind-mount merged layer onto actual system target
	if [[ $? -eq 0 ]]; then
		mount --bind "$merged_dir" "$target_path"
	fi
}

# Validate the overlays read from stdin without changing any state.
overlay_lib_check() {
	local app="$1"
	__overlay_lib_validate "$app" > /dev/null
}

# Register all requested target overlays for one app and apply mounts immediately.
# Paths are resolved/validated first (all-or-nothing) and pinned in installed.conf.
# Existing entries for the same app are removed first so registration order is refreshed.
# Reads target paths from stdin and ignores comments and empty lines.
overlay_lib_register() {
	local app="$1"
	local rows row req resolved installed_file
	local -A seen_rows=() seen_targets=()

	rows="$(__overlay_lib_validate "$app")" || {
		echo "ERROR: $app: overlays rejected; nothing registered" >&2
		return 1
	}

	# Unregister existing entries to clean state first (note: removes conf file if empty)
	overlay_lib_unregister "$app"

	__overlay_lib_init
	installed_file="$(__overlay_lib_installed_file)"
	__overlay_lib_forget_installed "$app"

	while IFS='|' read -r req resolved; do
		[[ -z "$resolved" ]] && continue
		row="$req|$resolved"
		[[ -n "${seen_rows[$row]+x}" ]] && continue
		seen_rows["$row"]=1
		echo "${app}|${row}" >> "$installed_file"
	done <<< "$rows"

	while IFS='|' read -r req resolved; do
		[[ -z "$resolved" ]] && continue
		[[ -n "${seen_targets[$resolved]+x}" ]] && continue
		seen_targets["$resolved"]=1

		if ! __overlay_lib_target_in_use "$resolved"; then
			__overlay_lib_target_supported "$resolved" || continue
		fi
		echo "${app}|${resolved}" >> "$OVERLAY_CONF_FILE"
		__overlay_lib_mount_target "$resolved"
	done <<< "$rows"
}

# Remove the pinned installation rows of an app (or all apps when no app is given).
__overlay_lib_forget_installed() {
	local app="${1:-}"
	local installed_file; installed_file="$(__overlay_lib_installed_file)"

	[[ -f "$installed_file" ]] || return 0
	if [[ -n "$app" ]]; then
		awk -F'|' -v app="$app" '$1 != app { print $0 }' "$installed_file" > "${installed_file}.tmp" &&
			mv "${installed_file}.tmp" "$installed_file"
	else
		: > "$installed_file"
	fi
	[[ -s "$installed_file" ]] || rm -f "$installed_file"
}

# Unregister and forget the app's installation (uninstall, as opposed to disable).
overlay_lib_uninstall() {
	local app="${1:-}"
	overlay_lib_unregister "$app"
	__overlay_lib_forget_installed "$app"
	rmdir "$OVERLAY_BASE_DIR" 2>/dev/null || true
}

# Print the unique resolved targets pinned for an app.
__overlay_lib_app_targets() {
	local app="$1"
	local installed_file; installed_file="$(__overlay_lib_installed_file)"

	[[ -f "$installed_file" ]] || return 0
	awk -F'|' -v app="$app" '$1 == app && $3 != "" && !seen[$3]++ { print $3 }' "$installed_file"
}

overlay_lib_unregister() {
	local app_name="${1:-}"
	local tmp_conf
	local target=""

	[[ ! -f "$OVERLAY_CONF_FILE" ]] && return 0

	tmp_conf="$(mktemp)"
	if [[ -n "${app_name}" ]]; then
		awk -F'|' -v app="$app_name" '$1 == app { print $2 }' "$OVERLAY_CONF_FILE" | sort -u > "$tmp_conf"
		awk -F'|' -v app="$app_name" '$1 != app { print $0 }' "$OVERLAY_CONF_FILE" > "${OVERLAY_CONF_FILE}.tmp" && mv "${OVERLAY_CONF_FILE}.tmp" "$OVERLAY_CONF_FILE"
	else
		awk -F'|' '{ print $2 }' "$OVERLAY_CONF_FILE" | sort -u > "$tmp_conf"
		: > "$OVERLAY_CONF_FILE"
	fi

	while IFS= read -r target; do
		[[ "$target" =~ ^[[:space:]]*(#|$) ]] && continue # skip comments and whitespace
		if [[ -n "${app_name}" ]]; then
			[[ -z "$target" ]] && continue
			if __overlay_lib_target_in_use "$target"; then
				continue
			fi
		fi

		__overlay_lib_unmount_target "$target"
		__overlay_lib_cleanup_target_dirs "$target"

	done < "$tmp_conf"

	# Safety net: when unregistering all, also drop any orphan merged mounts
	# that may remain even after the registration file has been cleared.
	[[ -z "${app_name}" ]] && __overlay_lib_unmount_orphan_runtime_mounts

	# if overlay.conf file is empty remove
	# then remove overlay base dir
	if [[ ! -s "$OVERLAY_CONF_FILE" ]]; then
		rm -f "$OVERLAY_CONF_FILE"
		rmdir "$OVERLAY_BASE_DIR" 2>/dev/null || true
	fi

	rm -f "$tmp_conf"
}

overlay_lib_get_upper_directories() {
	local app="${1}"
	local target upper_dir
	while IFS= read -r target; do
		upper_dir="$(__overlay_lib_get_runtime_dir "$target")/${OVERLAY_UPPER_DIRNAME}"
		echo "$target=$upper_dir"
	done < <(__overlay_lib_app_targets "$app")
}

__overlay_lib_mount_unmount() {
	local action="${1}"
	shift
	__overlay_lib_init

	[[ ! -f "$OVERLAY_CONF_FILE" ]] && return 0

	while IFS='|' read -r app_name target_path; do
		[[ "$app_name" =~ ^[[:space:]]*(#|$) ]] && continue # skip comments and whitespace

		__no_args_or_has_matched_arg "$app_name" "$@" || continue

		if [[ $action == "mount" ]]; then
			__overlay_lib_mount_target "$target_path"
		elif [[ $action == "unmount" ]]; then
			__overlay_lib_unmount_target "$target_path"
		fi
	done < "$OVERLAY_CONF_FILE"
}

__no_args_or_has_matched_arg() {
	(($#==1)) && return 0

	local match="$1"
	shift

	for arg in "$@"; do
		[[ "$arg" == "$match" ]] && return 0
	done

	return 1
}

overlay_list_mounts() {
	local app="${1}"
	local target runtime_dir
	while IFS= read -r target; do
		runtime_dir="$(__overlay_lib_get_runtime_dir "$target")/${OVERLAY_MERGED_DIRNAME}"
		mountpoint -q "$target" && mountpoint -q "$runtime_dir" \
			&& echo "overlay: $target (mounted)" \
			|| echo "overlay: $target (not mounted)"
	done < <(__overlay_lib_app_targets "$app")
}

case "${1:-}" in
	overlay-unregister)
		overlay_lib_unregister "${2-}"
		;;
	overlay-uninstall)
		overlay_lib_uninstall "${2-}"
		;;
	overlay-check)
		overlay_lib_check "${2}";;
	overlay-register)
		overlay_lib_register "${2}";;
	overlay-list-mounts)
		# overlay-list-mounts <app>
		overlay_list_mounts "${2}";;
	overlay-mount)
		shift 1
		__overlay_lib_mount_unmount "mount" "$@";;
	overlay-mount-unmount)
		shift 1
		__overlay_lib_mount_unmount "$@";;
	get-upper-overlay-path-mappings)
		# get-upper-overlay-path-mappings <app>
		overlay_lib_get_upper_directories "${2}";;
	overlay-reconcile)
		# overlay-reconcile <owned-files-list> <whiteouts-list>
		# Each file must contain one absolute target path per line.
		overlay_lib_reconcile "$2" "$3";;
esac
