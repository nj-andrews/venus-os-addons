#!/usr/bin/env bash

set -o nounset

#Used by the Vespera CLI for higher level scanning, binding and removal of usb devices

declare __this_path; __this_path="$(dirname "${BASH_SOURCE[0]}")"
declare VESPERA_DIR; VESPERA_DIR="$(cd "${__this_path}/.." && pwd)"

# shellcheck source=/data/dev/addons/vespera/src/data/apps/available/vespera/libs/source-lib
source "${VESPERA_ROOT:-}${VESPERA_DIR}/libs/source-lib"

#addsource "libs/lang-lib"
addsource "libs/dbus-lib"
addsource "libs/service-lib"
addsource "libs/serial-device-installer-lib"

declare DEFAULT_USB_PROPS="ID_MODEL,ID_VENDOR,ID_SERIAL,ID_PATH"

device_remove_all() {
	local dbus_name="${1}"
	local remove_all="${2:-1}"

	for sid in $("$VESPERA_DIR/scripts/list-device-bindings" "$dbus_name"); do
		device_remove "$sid" "$remove_all";
	done
}

device_remove() {
	local sid_or_tty="${1:-}"
	local remove_all="${2:-1}"
	local sid=

	[[ -n "${sid_or_tty}" ]] \
		|| { echo "Invalid arguments: bind expects <sid|tty>" >&2; return 1; }

	local tty_or_sid="${sid_or_tty#/dev/}"

	if [[ -e "/dev/${tty_or_sid}" ]]; then
		DEVICE_TTY="${tty_or_sid}"
	else
		DEVICE_SID="${tty_or_sid}"
		sdi_TTY_from_SID
	fi

	if [[ -n "$DEVICE_TTY" ]]; then
		sdi_service_name_from_tty "${DEVICE_TTY:-}" service_name 2>/dev/null &&
			service_lib_remove_service "$service_name.$DEVICE_TTY"
		sdi_remove_rule
	fi

	# use a grep filter so we catch both these paths
	# /Settings/Devices/sid_ae4f47c2eb37b65a/CustomName
	# /Settings/Devices/sid_ae4f47c2eb37b65a_GreyWasteTank2/ClassAndVrmInstance
	[[ -n ${DEVICE_SID} && ${remove_all} == 1 ]] &&
		dbus_lib_delete_tree "/Settings/Devices" "^/Settings/Devices/sid_${DEVICE_SID}" 1>/dev/null 2>&1

	return 0
}

device_scan_usb() {
	local tty
	local usbProps=

	for tty in $(sdi_get_available_devices); do

		sdi_fill_usb_props "$tty" "$DEFAULT_USB_PROPS" usbProps || continue;

		sdi_set_device_sid "$usbProps"
		usbProps=$(printf '%s\n' "$usbProps" | sed 's/,\?ID_PATH=[^,]*//')

		# The vespera service is responsible for adding the dbus settings
		# so just pass the values we have
		printf 'Device Discovered:\t%s\t%s\t%s\n' "$DEVICE_SID" "$tty" "$usbProps"
	done

	return 0
}

device_bind() {
	local tty="${1:-}"
	local service_name="${2:-}"
	local sid= usbProps=

	[[ -n "${tty}" && -n "${service_name}" ]] \
		|| { echo "Invalid arguments: bind expects <tty> <service-name>" >&2; return 1; }

	[[ ! -e "/dev/${tty}" ]] && { echo "Error: Invalid tty" >&2; return 1; }

	[[ $(sdi_get_available_devices "/dev/${tty}") != "${tty}" ]] \
		&& { echo "Error: tty ($tty) is not available" >&2; return 1; }

	sdi_fill_usb_props "${tty}" "${DEFAULT_USB_PROPS}" usbProps
	sdi_set_device_sid "${usbProps}" # hashed usbProps
	[[ -n "${sid}" ]] || sid="${DEVICE_SID}"

	# fill serial-starter-installer variables
	# shellcheck disable=SC2034
	DEVICE_UDEV_PROPS="${usbProps}";
	# shellcheck disable=SC2034
	DEVICE_TTY="${tty}"
	# shellcheck disable=SC2034
	DEVICE_SERVICE_NAME="${service_name}"

	[[ -d /opt/victronenergy/service-templates/"${service_name}" ]] ||
		sdi_service_mapping_exists || { echo "ERROR: invalid service" >&2; return 1; }

	sdi_install 1>/dev/null || return 1

	dbus_lib_set_string_value "/Settings/Devices/sid_${sid}/UsbProps" "${usbProps}" 1>/dev/null

	# Remove stale service symlinks
	#rm -f /service/*.${DEVICE_TTY} 2>/dev/null
	#find -L /service/ -maxdepth 1 -type l -delete

	# The vespera service is responsible for adding the dbus settings
	# so just pass that we have claimed the device.
	printf 'Device Claimed:\t%s\n' "${DEVICE_SID}"

	# In demo mode the serial starter-service is down
	# so manualy create and start the service in this case
	local demo_mode=
	dbus_lib_get_value "/Settings/Gui/DemoMode" demo_mode

	if [[ ${demo_mode:-0} != 0 ]]; then
		#echo "vespera: Venus OS in demo mode, manualy starting service"
		service_lib_start_templated_service "${tty}" "${service_name}"
		rm -f "/dev/serial-starter/${tty}"
	fi

}

case "${1:-}" in
	scan)
		shift
		device_scan_usb;;
	bind)
		shift
		device_bind "$@";;
	unbind|remove)
		shift
		device_remove "${1:-}";;
	unbind-all|remove-all)
		shift
		device_remove_all "$@";;
	start-all-device-services)
		device_start_all_device_services "${2}";;
	*)
		if [[ -n ${1:-} ]]; then
			echo "device: invalid command : ${1}" >&2
		fi
		;;
esac
