#!/usr/bin/env bash

set -o nounset

declare __this_path; __this_path="$(dirname "${BASH_SOURCE[0]}")"
declare VESPERA_DIR; VESPERA_DIR="$(cd "${__this_path}/.." && pwd)"

# shellcheck source=/data/dev/addons/vespera/src/data/apps/available/vespera/libs/source-lib
source "$VESPERA_DIR/libs/source-lib"
addsource "conf/vespera.conf"
VESPERA_FEEDS_SYMLINK="${VESPERA_DATA_DIR}/feeds.conf"

# Expand rootfs/ make it v
opkg_lib_expand_root_fs() {
	grep -qE " / .* ro[ ,]" /proc/mounts
	local is_ro=$?
	/opt/victronenergy/swupdate-scripts/resize2fs.sh
	[[ $is_ro == 0 ]] && mount -o remount,ro /
}

opkg_lib_list_packages() {
	opkg -f "${VESPERA_COMBINED_CONF_FILE}" list-installed | cut -d ' ' -f1
}

opkg_lib_list_enabled_packages() {
	for package in $(opkg_lib_list_packages); do
		[[ ! -e "/data/apps/enabled/$package" ]] && continue
		echo "$package"
	done
}

opkg_lib_get_configure_order() {
	[[ ! -f "${VESPERA_DATA_DIR}/status" ]] && return 0
	echo vespera # always output vespera first
	awk '
		/^Package: /       { pkg=$2 }
		/^Installed-Time:/ { time=$2 }
		/^$/ {
				if (time != "" && pkg != "vespera")
					print time "\t" pkg
			pkg=time=""
		}
	' "${VESPERA_DATA_DIR}/status" |
		sort -n |
		cut -f2
}

opkg_ensure_feed_symlink() {
	if [[ -L "${VESPERA_FEEDS_SYMLINK}" && ! -e "${VESPERA_FEEDS_SYMLINK}" ]]; then
		# 1. It IS a symlink, but its target does NOT exist (Broken Symlink)
		echo "vespera: feeds symlink target file not found: $(readlink "$VESPERA_FEEDS_SYMLINK")" >&2
		return 1
	elif [[ ! -e "${VESPERA_FEEDS_SYMLINK}" ]]; then
		# 2. Target/File does NOT exist (and it's not even a broken symlink)
		if [[ -f $VESPERA_FEEDS_FILE ]]; then
			ln -sf "$VESPERA_FEEDS_FILE" "$VESPERA_FEEDS_SYMLINK"
		else
			echo "vespera: feeds file not found: $VESPERA_FEEDS_FILE" >&2
		fi

	#  else  # 3. Target exists
	fi
}

opkg_ensure_combined_conf_file() {

	if [[ ! -f "${VESPERA_FEEDS_CONF_FILE}" ]]; then
		echo "vespera: feeds configuration not found: ${VESPERA_FEEDS_CONF_FILE}" >&2
		return
	fi

	opkg_ensure_feed_symlink || return

	local combined_dir tmp_file status
	combined_dir="$(dirname "${VESPERA_COMBINED_CONF_FILE}")"
	mkdir -p "${combined_dir}" || return 1
	tmp_file="$(mktemp "${VESPERA_COMBINED_CONF_FILE}.XXXXXX")" || return 1
	if ! cat "${VESPERA_FEEDS_CONF_FILE}" "${VESPERA_FEEDS_SYMLINK}" > "$tmp_file"; then
		echo "vespera: failed to combine feed configuration" >&2
		rm -f "$tmp_file"
		return 1
	fi
	if [[ -f "${VESPERA_COMBINED_CONF_FILE}" ]]; then
		if cmp -s "$tmp_file" "${VESPERA_COMBINED_CONF_FILE}"; then
			rm -f "$tmp_file"
			return
		else
			status=$?
			if (( status != 1 )); then
				echo "vespera: failed to compare feed configuration" >&2
				rm -f "$tmp_file"
				return 1
			fi
		fi
	fi
	mv -f "$tmp_file" "${VESPERA_COMBINED_CONF_FILE}"
}

opkg_lib_update() {
	local args=("$@")
	# if VESPERA_VERBOSITY < 2 then hide output from update
	# unless opkg option -V[n] has neen supplied
	if [[ "${VESPERA_VERBOSITY:-}" -lt 2 ]]; then
		local arg
		local has_verbosity=0

		for arg in "${args[@]}"; do
			case "$arg" in -V[0-9]) has_verbosity=1; break;;
			esac
		done

		[[ "$has_verbosity" -eq 0 ]] && args=("-V0" "${args[@]}")
	fi

	opkg -f "${VESPERA_COMBINED_CONF_FILE}" "${args[@]}" update || exit
}
