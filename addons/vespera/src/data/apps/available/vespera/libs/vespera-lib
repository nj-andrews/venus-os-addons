#!/usr/bin/env bash

set -o nounset

VESPERA_IN_GUI="${VESPERA_IN_GUI:-false}"
VESPERA_VERBOSITY="${VESPERA_VERBOSITY-}"
VESPERA_WORKING_DIR="${VESPERA_WORKING_DIR-}"

__vespera_path="$(dirname "${BASH_SOURCE[0]}")"
__vespera_path="$(cd "${__vespera_path}/.." && pwd)"

# shellcheck source=/data/dev/addons/vespera/src/data/apps/available/vespera/libs/source-lib
source "$__vespera_path/libs/source-lib"
addsource "conf/vespera.conf"
addsource "libs/opkg-lib"
addsource "libs/lang-lib" "$__vespera_path"

vespera_lib_log_verbose2() { [[ "${VESPERA_VERBOSITY}" -gt 1 ]]; }
vespera_lib_log_verbose3() { [[ "${VESPERA_VERBOSITY}" -gt 2 ]]; }

vespera_lib_app_enabled() { test -e "/data/apps/enabled/${1}"; }

vespera_lib_index() {
	if [[ -f "$VESPERA_INDEXER" ]]; then
		opkg_ensure_combined_conf_file
		"$VESPERA_INDEXER" "$VESPERA_VERBOSITY"
	fi
}

