#!/usr/bin/env bash

set -o nounset

__this_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$__this_path/../libs/source-lib"
addsource "conf/vespera.conf"

feed_name="${1:-}"
feed_file="${VESPERA_APP_DIR}/conf/feeds-${feed_name}.conf"

# This helper only creates a new feed file. The active feed symlink is owned by
# opkg_lib_set_feed_source() in the library; do not duplicate that logic here.
[[ -n "$feed_name" ]] || { echo "feed name required" >&2; exit 1; }
[[ "$feed_name" =~ [^a-zA-Z0-9_-] ]] && { echo "Invalid feed name: $feed_name" >&2; exit 1; }

printf 'feed name not found:%s\n' "$feed_file" >&2
printf "Add new feed '%s'? [y/N]: " "$feed_name" >&2
if ! IFS= read -r reply; then
	echo >&2
	exit 1
fi

case "${reply,,}" in
	y|yes)
		;;
	*)
		echo "Aborted: feed '$feed_name' was not created." >&2
		exit 1
		;;
esac

mkdir -p "$(dirname "$feed_file")"
tmp_file="$(mktemp "${TMPDIR:-/tmp}/vespera-feed-${feed_name}.XXXXXX")"
cat > "$tmp_file" <<EOF
# Add one or more src/gz lines for feed '$feed_name'
# Example:
# src/gz $feed_name http://example.com/feed
EOF

if command -v nano >/dev/null 2>&1; then
	nano "$tmp_file"
else
	echo "nano is not installed; add valid src/gz lines to: $tmp_file" >&2
	exit 1
fi

valid_lines=()
while IFS= read -r line || [[ -n "$line" ]]; do
	line="${line#${line%%[![:space:]]*}}"
	line="${line%${line##*[![:space:]]}}"
	[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
	if [[ "$line" =~ ^src/gz[[:space:]]+${feed_name}[[:space:]]+[^[:space:]]+([[:space:]]|$) ]]; then
		valid_lines+=("$line")
	fi
done < "$tmp_file"

if [[ ${#valid_lines[@]} -eq 0 ]]; then
	rm -f "$tmp_file"
	echo "No valid src/gz entries were supplied for feed: $feed_name" >&2
	exit 1
fi

printf '%s\n' "${valid_lines[@]}" > "$feed_file"
rm -f "$tmp_file"
exit 0
