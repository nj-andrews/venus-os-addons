#!/usr/bin/env bash

__vespera_path="$(dirname "${BASH_SOURCE[0]}")"
__vespera_path="$(cd "${__vespera_path}/.." && pwd)"

# shellcheck source="../conf-default/vespera.conf"
source "$__vespera_path/conf/vespera.conf"
VESPERA_DATA_DIR="${VESPERA_ROOT:-}${VESPERA_DATA_DIR}"
# shellcheck source="../libs/opkg-lib"
source "$__vespera_path/libs/opkg-lib"

declare _venus_services_to_restart=()
declare _refresh_devices=

for app in $(opkg_lib_list_enabled_packages); do

	[[ "$#" -eq 0 ]] || [[ " $* " == *" $app "* ]] || continue
	app="${app##*/}"
	sidecar_file_prefix="$VESPERA_DATA_DIR/info/$app"

	# call custom hook if available
	[[ -f "${sidecar_file_prefix}.disable" ]] &&
		"${sidecar_file_prefix}.disable"

	# enable v1 menus/overview pages
	"$__vespera_path/scripts/set-state-v1-menus" "${sidecar_file_prefix}.installer-menus" "disable"
	"$__vespera_path/scripts/set-state-nav-pages" "${sidecar_file_prefix}.installer-navigation-pages" "disable"

	# remove services
	"${__vespera_path}/scripts/remove-services" "${app}" _refresh_devices

	# unregister overlays
	"${VESPERA_DATA_DIR}/info/vespera.overlay-lib" overlay-unregister "${app}";

	# updated dbus package enabled state
	declare dbus_name; dbus_name=$(cat "${sidecar_file_prefix}.${VESPERA_DBUS_FILE}")
	[[ -n $dbus_name ]] &&
		dbus -y com.victronenergy.settings "/Settings/Vespera/Packages/$dbus_name/Enabled" SetValue "0" 1>/dev/null 2>&1

	# remove enabled symlink
	rm -f "${VESPERA_ROOT:-}/data/apps/enabled/$app"

	# fetch file with services to restart
	# TODO remove and use app loop in vespera-lib to do this?
	[[ -f "${sidecar_file_prefix}.installer-services" ]] &&
		_venus_services_to_restart+=("${sidecar_file_prefix}.installer-services")

done

declare -p _refresh_devices _venus_services_to_restart