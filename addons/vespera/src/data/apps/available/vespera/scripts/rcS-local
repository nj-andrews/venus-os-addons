#!/usr/bin/env bash

__vespera_path="$(dirname "${BASH_SOURCE[0]}")"
__vespera_path="$(cd "${__vespera_path}/.." && pwd)"

# shellcheck source="../conf-default/vespera.conf"
source "$__vespera_path/conf/vespera.conf"
VESPERA_DATA_DIR="${VESPERA_ROOT:-}${VESPERA_DATA_DIR}"
VESPERA_VENUS_VERSION_FILE="${VESPERA_ROOT:-}${VESPERA_VENUS_VERSION_FILE}"
# shellcheck source="../libs/opkg-lib"
source "$__vespera_path/libs/opkg-lib"

__log_verbose2() { [[ "${VESPERA_VERBOSITY}" -gt 1 ]]; }

__vespera_overlay() { "${VESPERA_DATA_DIR}/info/vespera.overlay-lib" "$@"; }

__refresh_udevadm() {

	if [[ -d "$VESPERA_DATA_DIR/overlays/_etc_udev_rules.d/merged" ]]; then
		# overlay for udev rules exists then reload udev rules
		udevadm control --reload
		udevadm trigger --action=add --subsystem-match=tty --property-match=ID_BUS=usb >/dev/null
		udevadm settle >/dev/null
	fi
}

__start_all_services() {
	# launch in background
	# start-all-services waits for localsettings service to
	# start before starting services
	"$__vespera_path/scripts/start-all-services" &
}

__reconcile_overlays() {
	local reconcile_dir owned_files whiteouts app

	reconcile_dir="$(mktemp -d)" || return 1
	owned_files="$reconcile_dir/files"
	whiteouts="$reconcile_dir/whiteouts"

	: > "$owned_files"
	: > "$whiteouts"

	for app in $(opkg_lib_list_packages all); do
		[[ -f "${VESPERA_DATA_DIR}/info/$app.list" ]] &&
			awk '{ print $1 }' "${VESPERA_DATA_DIR}/info/$app.list" >> "$owned_files"

		[[ -f "${VESPERA_DATA_DIR}/info/$app.$VESPERA_WHITEOUTS_FILE" ]] &&
			awk '{
				sub(/[[:space:]]*#.*$/, "", $0)
				gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
				if ($0 != "") print
			}' "${VESPERA_DATA_DIR}/info/$app.$VESPERA_WHITEOUTS_FILE" >> "$whiteouts"
	done

	__vespera_overlay overlay-reconcile "$owned_files" "$whiteouts"

	rm -rf "$reconcile_dir"
}

__firmware_changed() {

	echo "*********************************************"
	echo "Firmware changed, configuring packages"
  echo "$(date '+%Y-%m-%d %H:%M:%S')"

	# shellcheck source=../libs/vespera-lib
	source "$__vespera_path/libs/vespera-lib"

	opkg_lib_expand_root_fs

	cp "$VESPERA_VENUS_VERSION_FILE" "$VESPERA_VENUS_VERSION_FILE.old"
	cp "${VESPERA_ROOT:-}/opt/victronenergy/version" "$VESPERA_VENUS_VERSION_FILE"

	echo "Reconciling overlays"
	__reconcile_overlays

	__vespera_lib_initialize
	VESPERA_VERBOSITY=2
	: > "${VESPERA_WORKING_DIR}/${VESPERA_VENUS_FIRMWARE_CHANGED_FILE}"
	echo "$VESPERA_VERBOSITY" > "${VESPERA_WORKING_DIR}/$VESPERA_VERBOSITY_FILE"


	opkg_ensure_combined_conf_file

	echo "Configuring packages"

	for app in $(opkg_lib_get_configure_order); do
		echo "  configuring package ${app}"
		[[ -f "$VESPERA_DATA_DIR/info/${app}.installer-overlays" ]] &&
			__vespera_overlay overlay-register "${app}" < "$VESPERA_DATA_DIR/info/${app}.installer-overlays"
		"$VESPERA_DATA_DIR/info/$app.postinst" "firmware-changed"
		! vespera_lib_app_enabled "$app" && {
			__vespera_overlay overlay-unregister "${app}"
		}
	done
	echo "Configuring packages completed"

	__refresh_udevadm

	echo "Starting all services"
	__start_all_services

	__vespera_lib_cleanup

	echo "Executing all rcS.local startup scripts for enabled apps"
	"$__vespera_path/scripts/execute-startup-scripts" rcS.local

	echo "done"
}

declare log_file="${VESPERA_ROOT:-}/var/log/vespera/rcS-local.log"
mkdir -p "$(dirname "$log_file")"

VESPERA_VERBOSITY=-1
[[ -n "${1:-}" ]] && VESPERA_VERBOSITY="${1}"

((VESPERA_VERBOSITY < 0)) && {
	VESPERA_VERBOSITY=$((-VESPERA_VERBOSITY));
	exec > "$log_file" 2>&1; } # note file overwrite for each reboot

if [[ ! -f "$VESPERA_VENUS_VERSION_FILE" ]]; then
	# no version file exists copy
	cp "${VESPERA_ROOT:-}/opt/victronenergy/version" "$VESPERA_VENUS_VERSION_FILE"
fi

if cmp -s "$VESPERA_VENUS_VERSION_FILE" "${VESPERA_ROOT:-}/opt/victronenergy/version"; then
	echo "Firmware versions match; mounting"
	__vespera_overlay overlay-mount
	__refresh_udevadm
	__start_all_services
	"$__vespera_path/scripts/execute-startup-scripts" rcS.local
	exit 0
fi

__firmware_changed
