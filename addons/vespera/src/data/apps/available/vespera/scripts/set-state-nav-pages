#!/usr/bin/env bash

action="${1}"
file="${1}"
dbus_path="${3}"
[[ ! -f "$file" ]] && exit 0

__vespera_path="$(dirname "${BASH_SOURCE[0]}")"
__vespera_path="$(cd "${__vespera_path}/.." && pwd)"

# shellcheck source="../libs/opkg-lib"
source "$__vespera_path/libs/dbus-lib"

csvPages=
aryPages=()

dbus_lib_get_value "$dbus_path" csvPages
dbus_lib_parse_csv "$csvPages" aryPages

while IFS= read -r page; do
	for ((i = 0; i < ${#aryPages[@]}; i++)); do
		pg="${aryPages[i]}"

		if [[ "$action" == "enable" ]]; then
			[[ "${pg:0:1}" != "~" ]] && continue
			[[ "${pg:1}" == "$page" ]] || continue
			aryPages[i]="$page"
		else
			[[ "${pg:0:1}" == "~" ]] && continue
			[[ "$pg" == "$page" ]] || continue
			aryPages[i]="~$pg"
		fi
	done
done <<< "$("$__vespera_path/scripts/read-sidecar-file" "$file")"

dbus_lib_join_csv aryPages csvPages  || return 1
dbus_lib_set_string_value "$dbus_path" "$csvPages"