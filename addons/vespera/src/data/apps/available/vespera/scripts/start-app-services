#!/usr/bin/env bash

__vespera_path="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.."

# shellcheck source="../conf-default/vespera.conf"
source "${__vespera_path}/conf/vespera.conf"
VESPERA_DATA_DIR="${VESPERA_ROOT:-}$VESPERA_DATA_DIR"
VESPERA_VERBOSITY=$(cat "${PKG_WORKING_DIR}/verbosity" 2>/dev/null || echo 1)
vespera_lib_log_verbose2() { [[ "${VESPERA_VERBOSITY}" -gt 1 ]]; }

declare app="${1}"
declare dbus_name="${2}"
declare available_app_path="${VESPERA_ROOT:-}/data/apps/available/${app}"
declare service_root="${VESPERA_ROOT:-}/service"
#declare service_templates_root="${VESPERA_ROOT:-}/opt/victronenergy/service-templates"
declare services_file="${VESPERA_DATA_DIR}/info/${app}.${VESPERA_APP_SERVICES_FILE}"
declare templated_services_file="${VESPERA_DATA_DIR}/info/${app}.${VESPERA_APP_TEMPLATE_SERVICES_FILE}"
declare has_templated_devices=false refresh_devices=false serial_starter_up=false

__start_template_services() {

	# shellcheck source="../libs/service-lib"
	source "$__vespera_path/libs/service-lib"
	# shellcheck source="../libs/service-lib"
	source "$__vespera_path/libs/serial-device-installer-lib"

	#TODO: look at replacing list-device-bindings with tty loop
	for sid in $("$__vespera_path/scripts/list-device-bindings" "$dbus_name"); do
		DEVICE_SID="${sid}"
		vespera_lib_log_verbose2 && echo "Starting device: $DEVICE_SID ($dbus_name)"
		local service_name=

		sdi_TTY_from_SID &&
			sdi_service_name_from_tty "${DEVICE_TTY}" service_name &&
				service_lib_start_templated_service "${DEVICE_TTY}" "${service_name}" &&
					rm -f "/dev/serial-starter/${DEVICE_TTY}"
	done

}

for service in $(cat "${services_file}" 2>/dev/null); do
	if [[ -e "${service_root}/$service" ]]; then
		svc -u "${service_root}/$service"
		svc -u "${service_root}/$service/log" 2>/dev/null
	else
		cp -a "$available_app_path/service/$service" "${service_root}/$service"
		sleep 0.1
	fi
done

for service in $(cat "${templated_services_file}" 2>/dev/null); do
	[[ -z $service ]] && continue
	has_templated_devices=true
	break
done

vespera_lib_log_verbose2 && echo "has_templated_devices: $has_templated_devices"
vespera_lib_log_verbose2 && echo "VESPERA_ALWAYS_START_SERVICES: $VESPERA_ALWAYS_START_SERVICES"

if [[ $has_templated_devices == true ]]; then

	svstat "/service/serial-starter" | grep -q "^/service/serial-starter: up " && serial_starter_up=true
	vespera_lib_log_verbose2 && echo "serial_starter_up: $serial_starter_up"
	if [[ $serial_starter_up == false ]]; then
		if [[ $VESPERA_ALWAYS_START_SERVICES == true ]]; then
			vespera_lib_log_verbose2 && echo "Starting template device services (serial-starter service down)"
			__start_template_services
		else
			vespera_lib_log_verbose2 && echo "Warning serial-starter down (demo mode?); Template services will not be started"
		fi
	else
		refresh_devices=true
		vespera_lib_log_verbose2 && echo "serial starter up, should start template services automatically..."
	fi
else
	vespera_lib_log_verbose2 && echo "no template services found"
fi

[[ $refresh_devices == true ]] &&
	exit 2
