#!/bin/bash

# Vespera CLI script

declare -g __vespera_path; __vespera_path="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
source "$__vespera_path/libs/source-lib"
addsource "libs/vespera-lib"

vespera_show_help() {
	cat <<'EOF'
Usage:
	vespera [options] [command] [arguments...]
	vespera [opkg-options] [opkg-args...]

Vespera options:
	--help, help                  Show this help
	-V0 .. -V4                    Set opkg verbosity level
	--in-gui                      Internal GUI mode flag

Commands:
	status                        Show Vespera status via opkg
	inspect, i [app ...]          Show app, service, addon, and dbus details
	list-enabled, le [app ...]    List enabled apps/packages
	feed <subcommand> ...         Manage active feed configurations
	device <subcommand> ...       Device discovery and binding actions
	fs-ro|fs-rw                   Remount the fs as read-only|read-write
	overlays [mount|unmount]      Mount/Unmount overlays. (or lists overlays when no args)
	enable [app ...]              Enable matching installed apps (or all when no args)
	disable [app ...]             Disable matching enabled apps (or all when no args)
	update                        Update package metadata and regenerate indexes

Feed family:
	feed                          Print active feed config name
	feed list                     Prints a list of available feed configs
	feed set                      Sets the active feed
	feed add                      Adds a new feed config
	feed remove                   Removes a feed config

  feed sources                         Show a list of the feed sources feom the active feed.
	feed add-source <name> <url>         Add a feed entry to the active feed
	feed edit-source <name> <url> [old]  Edit feed URL, optionally rename from [old]
	feed remove-source <name>            Remove a feed entry from the active feed

Device family:
	device scan                   Discover available serial devices
	device bind <tty> <svc>       Bind a serial device to service template <svc>
	device unbind <tty|sid>       Remove one binding by tty port or device sid
	device remove <sid>           Alias of device unbind
	device unbind-all <dbus-name> Remove all bindings for a dbus service
	device remove-all <dbus-name> Alias of device unbind-all

Examples:
	vespera feed set develop
	vespera feed add-source myfeed https://example.invalid/feed
	vespera device bind ttyUSB0 dbus-serialbattery
	vespera device unbind 8f9a3c12

Notes:
	Any arguments not handled above are passed directly to opkg.
EOF
}


# get and remove vesera args, then replace $@ with trimmed args
declare -a args=()
declare command=

function getOptions() {
	local -n __options="${1}"
	shift
	__options=()
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-*) __options+=("$1") ;;
		esac
		shift
	done
}

function onlyOptions() {
	while [ "$#" -gt 0 ]; do
		case "$1" in
			-*);;
			*) return 1;;
		esac
		shift
	done
	return 0
}

function processArgs() {

	command=""
	args=()
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--in-gui)
			  # shellcheck disable=SC2034 # used upstream
				VESPERA_IN_GUI=true;;
			-V[0-4])
				 # shellcheck disable=SC2034 # used upstream
				VESPERA_VERBOSITY="${1#-V}"
				args+=("$1");;
			--help)
				vespera_show_help;;
			-f|--conf) echo "$1; Not supported"; exit 1;;
			*)
				if [[ -z $command && ${1:0:1} !=  "-" ]]; then
					command="$1"
				else
					args+=("$1")
				fi
				;;
		esac
		shift
	done

}

processArgs "$@"
set -- "${args[@]}"

[[ $VESPERA_IN_GUI == true ]] && {
	for ((i=1; i<=10; i++)); do
		echo "$command, $1: step $i"
		sleep 1
	done
	exit 0
}

opkg_ensure_combined_conf_file

case "$command" in
	# update-index)
	# 	vespera_lib_index; exit;;
	help)
		vespera_show_help; exit;;
	version)
		exec awk '/Version:/ {print $2}' "${VESPERA_DATA_DIR}/info/vespera.control" 2>/dev/null;;
	fs-ro|fs-rw)
		mount -o remount,"${command:(-2)}" /; exit;;
	feed)
		case "${1:-}" in
			set|add) opkg_lib_feed_conf_set_add "${1:-}" "${2:-}";;
			list) opkg_lib_feed_conf_available;;
			remove) opkg_lib_feed_conf_remove "${2:-}";;
			sources)
				opkg_lib_show_feed_sources "${2:-}";;
			*-source)
				sub_command="${1%%-source}"
				shift
				opkg_lib_feed_crud "$sub_command" "$@" && vespera_lib_index;;
			*) opkg_lib_show_feed_name "${1:-}";;
		esac
		exit
		;;

	overlays)
		if [[ "$#" -eq 0 ]]; then
			cat "$VESPERA_DATA_DIR/overlays/overlays.conf"
			echo
		elif [[ $1 == "mount" || $1 == "unmount" ]]; then
			"$__vespera_path/libs/overlay-lib" overlay-mount-unmount "$@"

		else
			echo "Invalid sub command: [mount|unmount] expected"
		fi
		exit;;
	device)
		"$__vespera_path/libs/device-lib" "$@"; exit;;
	status)
		exec opkg -f "${VESPERA_COMBINED_CONF_FILE}" "$command" "$@" | opkg_lib_process_opkg_status "$@"; exit;;
	inspect|i)
		( . "$__vespera_path/scripts/inspect" "$@" ); exit;;
	list-enabled|le)
		opkg_lib_list_enabled_packages "all" "$@"; exit;;
	list-feeds)
		opkg_lib_list_available_feed_configs; exit;;
	enable|disable)
		vespera_lib_enable_disable "$command" "$@"; exit;;
	update)
		options=
		getOptions options "$@"
		opkg_lib_update "${options[@]}"|| exit
		onlyOptions "$@" && { vespera_lib_index; exit; }
		processArgs "$@"
		set -- "${args[@]}"
		;;
esac

[[ -z "$command" && -z "$*" ]] && {
	vespera_show_help
	echo
	exec opkg -f "${VESPERA_COMBINED_CONF_FILE}"
}

vespera_lib_pre_install "$command" "$@"

opkg -f "${VESPERA_COMBINED_CONF_FILE}" "$command" "$@"
retval=$?

vespera_lib_post_install "$command"

exit $retval