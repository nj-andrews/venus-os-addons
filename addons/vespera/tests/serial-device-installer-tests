test_tty_from_sid_use_usb_props_sets_tty_when_sid_prop_missing() {
  # Arrange
  stage_default_vars
  DEVICE_SID="sid-from-props"
  DEVICE_TTY=
  DEFAULT_USB_PROPS='ID_MODEL,ID_VENDOR,ID_SERIAL,ID_PATH'

  __sdi_get_tty_paths() {
    local -n out_paths="$1"
    out_paths=("${SERIAL_STARTER_DEV_DIR}/ttyUSB0")
  }

  sdi_get_sid_from_tty() {
    # Force fallback path via use-usb-props.
    return 0
  }

  sdi_fill_usb_props() {
    local _tty="$1"
    local _props="$2"
    local -n out="$3"
    out="ID_MODEL=M,ID_VENDOR=V,ID_SERIAL=S-ttyUSB0,ID_PATH=P-ttyUSB0"
  }

  sdi_set_device_sid() {
    local props="$1"
    [[ "$props" == *'ttyUSB0'* ]] && DEVICE_SID='sid-from-props'
  }

  # Act
  sdi_TTY_from_SID "use-usb-props"

  # Assert
  assert_exitcode 0
  assert_eq "ttyUSB0" "$DEVICE_TTY"
  assert_eq "sid-from-props" "$DEVICE_SID"
}

test_tty_from_sid_use_usb_props_round_trip_from_fill_and_set_sid() {
  # Arrange
  stage_default_vars
  local expected_tty="ttyUSB0"
  local usbProps=
  DEFAULT_USB_PROPS='ID_MODEL,ID_VENDOR,ID_SERIAL,ID_PATH'

  __sdi_get_tty_paths() {
    local -n out_paths="$1"
    out_paths=("${SERIAL_STARTER_DEV_DIR}/${expected_tty}")
  }

  udevadm() {
    cat <<'EOF'
ID_MODEL=M
ID_VENDOR=V
ID_SERIAL=S-ttyUSB0
ID_PATH=P-ttyUSB0
EOF
  }

  sdi_get_sid_from_tty() {
    # Force fallback path via use-usb-props.
    return 0
  }

  # Build SID from usbProps first (round trip source).
  sdi_fill_usb_props "$expected_tty" "$DEFAULT_USB_PROPS" usbProps
  sdi_set_device_sid "$usbProps"
  local sid="$DEVICE_SID"
  DEVICE_TTY=
  DEVICE_SID="$sid"

  # Act
  sdi_TTY_from_SID "use-usb-props"

  # Assert
  assert_exitcode 0
  assert_eq "$expected_tty" "$DEVICE_TTY"
}

