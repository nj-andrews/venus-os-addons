#fake overriden udevadm method
udevadm() {
  local tty_path="${SERIAL_STARTER_DEV_DIR:-/dev}/${_TTY:-}"

  # shellcheck disable=SC2199
  if [[ "$*" == "info --query=property --name=${tty_path}" || "$*" == "info --name=/dev/${_TTY:-} --query=property" ]]; then
     # echo load from file to get consistant test results even when usb device is not available
     echo "$(<"${assets_dir}/udevadm.output.${_TTY}")"

  else
     # swallow non-property queries; tests mock udevadm behavior instead of using the host system.
     return 0
  fi
  return 0
}

