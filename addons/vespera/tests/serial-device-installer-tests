__stage_mock_tty_devices() {
  local dev_dir="${1:-$SERIAL_STARTER_DEV_DIR}"
  mkdir -p "$dev_dir"
  for tty in tty ttyUSB0 ttyACM0; do
    : > "$dev_dir/${tty}" || true
  done
}

__stage_file_from_assets_or_empty() {
  local rel_path="$1"
  local target_path="${output_dir}/${rel_path}"

  mkdir -p "$(dirname "$target_path")"
  if [[ -f "${assets_dir}/${rel_path}" ]]; then
    cp "${assets_dir}/${rel_path}" "$target_path"
  else
    : > "$target_path"
  fi
  chmod +w "$target_path"
}

# stages the directories inside the output directory for starting services
stage_service_paths() {
  output_path_len="${#output_dir}"
  start_path="${SERIAL_STARTER_START_SERVICE_PATH:0:$output_path_len}"

  # ensure the path is inside the output folder
  [[ "$start_path" != "${output_dir}" ]] && {
    echo "stage_service_paths:Error invalid SERIAL_STARTER_START_SERVICE_PATH path!"; exit 1; }

  mkdir -p "$SERIAL_STARTER_START_SERVICE_PATH"

  rm -f $SERIAL_STARTER_START_SERVICE_PATH/*
  rm -f "/var/lock/serial-starter/*"
  rm -f "/run/lock/serial-starter/*"

  start_path="${SERVICE_PATH:0:$output_path_len}"
  [[ "$start_path" != "${output_dir}" ]] && {
    echo "stage_service_paths:Error invalid SERVICE_PATH path!"; exit 1; }

  mkdir -p "$SERVICE_PATH"
}

