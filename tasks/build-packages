#!/usr/bin/env bash

set -euo pipefail

####################################################################
# Creates all (default) the opkg packages in the folders
#   ../addons
# Ignored files/folders
#   .bak, .git, .tmp, /tests, -v[0-9], .old, .venv
# All files are develop (copied to ) ../.build and built from there.
# Symlinks are preserved as symlinks (do not dereference targets during copy)
# Args:
#   Arg1:"all" (default): Builds all folders under under services & utils.
#   Arg[n]: Or a list of folders under services or utils to build
# Options:
#   --develop-only             Build with a UTC ~YYMMDD.HHMM version stamp
#   --beta-only TYPE           Build a beta or rc into the beta feed
#   --notes TEXT               Notes for a beta feed publication
#   --release-only             Build newer package versions into release feeds, stage, and tag
#   --clean-develop            Remove all contents from the develop feeds folder
####################################################################

command -v opkg-build >/dev/null 2>&1 || { echo "ERROR: opkg-build not installed"; exit 1; }
command -v opkg-make-index >/dev/null 2>&1 || { echo "ERROR: opkg-make-index not installed"; exit 1; }
command -v rsync >/dev/null 2>&1 || { echo "ERROR: rsync not installed"; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "ERROR: python3 not installed"; exit 1; }

this_path="$(dirname "${BASH_SOURCE[0]}")"

declare -a build_items=()
declare -a folders=("../addons")
declare -a cli_build_args=()
declare -a normalized_cli_build_args=()
declare pwd_old="$PWD"
declare -A update_feeds=()
declare -i develop_only=0
declare -i release_only=0
declare -i beta_only=0
declare -i refresh_beta=0
declare beta_type="" beta_notes="" build_stamp=""
declare -i clean_develop_only=0
declare -i all_mode=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] [all|<package> ...]

Options:
  --develop-only           Build and index packages in develop only.
                           Version is stamped as MAJOR.MINOR.PATCH~YYMMDD.HHMM (UTC).
  --release-only           Build newer versions, stage feeds/release, and create local tags.
  --beta-only beta|rc      Build prerelease packages into feeds/beta.
  --refresh-beta           Refresh the beta feed's stable baseline without building.
  --notes TEXT             Required notes describing changes and known issues.
  --clean-develop          Remove all contents from the develop feeds folder
  -h, --help               Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --develop-only)
      develop_only=1
      ;;
    --release-only)
      release_only=1
      ;;
    --beta-only)
      (( $# >= 2 )) || { echo "ERROR: --beta-only requires beta or rc" >&2; exit 1; }
      beta_only=1
      beta_type="$2"
      shift
      ;;
    --refresh-beta)
      beta_only=1
      refresh_beta=1
      ;;
    --notes)
      (( $# >= 2 )) || { echo "ERROR: --notes requires text" >&2; exit 1; }
      beta_notes="$2"
      shift
      ;;
    --clean-develop)
      clean_develop_only=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      cli_build_args+=("$@")
      break
      ;;
    *)
      cli_build_args+=("$1")
      ;;
  esac
  shift
done

# Normalize positional package arguments so both of these forms work:
#   make-packages vespera mount-shares
#   make-packages "vespera mount-shares"
# This is especially useful for task runners that pass prompt input as one arg.
for arg in "${cli_build_args[@]}"; do
  if [[ "$arg" =~ [[:space:]] ]]; then
    read -r -a _split <<< "$arg"
    normalized_cli_build_args+=("${_split[@]}")
  else
    normalized_cli_build_args+=("$arg")
  fi
done

cli_build_args=("${normalized_cli_build_args[@]}")

(( develop_only + release_only + beta_only <= 1 )) || {
  echo "ERROR: build modes cannot be combined" >&2
  exit 1
}

(( clean_develop_only == 0 || develop_only == 0 )) || {
  echo "ERROR: --clean-develop cannot be combined with --develop-only" >&2
  exit 1
}

(( clean_develop_only == 0 || release_only == 0 )) || {
  echo "ERROR: --clean-develop cannot be combined with --release-only" >&2
  exit 1
}
(( clean_develop_only == 0 || beta_only == 0 )) || {
  echo "ERROR: --clean-develop cannot be combined with --beta-only" >&2
  exit 1
}
if (( beta_only == 1 )); then
  if (( refresh_beta == 1 )); then
    [[ -z "$beta_type" && -z "$beta_notes" && ${#cli_build_args[@]} -eq 0 ]] || {
      echo "ERROR: --refresh-beta cannot be combined with beta type, notes or packages" >&2; exit 1;
    }
  else
    [[ "$beta_type" == beta || "$beta_type" == rc ]] || { echo "ERROR: expected beta or rc" >&2; exit 1; }
    [[ "$beta_notes" =~ [^[:space:]] ]] || { echo "ERROR: beta builds require --notes" >&2; exit 1; }
  fi
  [[ -z "$(git -C "$this_path/.." status --porcelain --untracked-files=normal)" ]] || {
    echo "ERROR: beta builds require a clean working tree" >&2; exit 1;
  }
  source_commit="$(git -C "$this_path/.." rev-parse --verify 'HEAD^{commit}')"
elif [[ -n "$beta_notes" ]]; then
  echo "ERROR: --notes requires --beta-only" >&2; exit 1
fi
build_stamp="$(date -u +'%y%m%d.%H%M')"

cd "$this_path" || exit 1

this_path="."
feeds_root="../feeds"
develop_root="${feeds_root}/develop"
release_root="${feeds_root}/release"
beta_root="${feeds_root}/beta"
test_feed_name="test-feed"
test_feed_root="${feeds_root}/${test_feed_name}"
examples_feed_name="examples"
examples_feed_root="${feeds_root}/develop/${examples_feed_name}"

feed_name_for_package() {
  local name="$1"
  if [[ "$name" == test-* ]]; then
    echo "$test_feed_name"
	elif [[ "$name" == *-example-* ]]; then
		echo "$examples_feed_name"
  elif [[ "$name" == "vespera" ]]; then
    echo "vespera"
  else
    echo "addons"
  fi
}

feed_path_for_name() {
  local feed_name="$1"
  if [[ "$feed_name" == "$test_feed_name" ]]; then
    echo "$test_feed_root"
  elif (( beta_only == 1 )); then
    echo "${beta_root}/${feed_name}"
	elif [[ "$feed_name" == "$examples_feed_name" ]]; then
		echo "$examples_feed_root"
  elif (( release_only == 1 )); then
    echo "${release_root}/${feed_name}"
  else
    echo "${develop_root}/${feed_name}"
  fi
}

acquire_feed_lock() {
  command -v flock >/dev/null 2>&1 || { echo "ERROR: flock not installed" >&2; return 1; }
  mkdir -p "$feeds_root"
  exec 9>"${feeds_root}/.package-operations.lock"
  flock -n 9 || { echo "ERROR: another package build is in progress" >&2; return 1; }
}

# Drop Packages.stamps entries ("<epoch> <file>.ipk") whose ipk no longer exists in the feed.
trim_feed_stamps() {
  local feed_path="${1}"
  local stamps="$feed_path/Packages.stamps"
  local tmp stamp file

  [[ -f "$stamps" ]] || return 0
  tmp="$(mktemp)"
  while read -r stamp file; do
    [[ -n "$file" && -f "$feed_path/$file" ]] && echo "$stamp $file"
  done < "$stamps" > "$tmp"
  cat "$tmp" > "$stamps"
  rm -f "$tmp"
}

build_feed_index() {
  local feed_path="${1}"
  (cd "$feed_path" && opkg-make-index -p Packages ./ 1>/dev/null)
  trim_feed_stamps "$feed_path"
  echo "feed ${feed_path} updated"
}

build_feed_indexes() {
  # Loop through all values in update_feeds and call build_feed_index
  for feed_path in "${update_feeds[@]}"; do
    build_feed_index "$feed_path"
  done
}

folder_has_newer_file_than_ipk() {
  local ipk_path="$1"
  local base_folder="$2"
  find "$base_folder" -type f -newer "$ipk_path" -print -quit | grep -q .
}

newest_ipk_for_package() {
  local feed_path="$1"
  local package_name="$2"

  [[ -d "$feed_path" ]] || return 0

  find "$feed_path" -maxdepth 1 -type f -name "${package_name}_*.ipk" -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-
}

build_package_if_needed() {
  local pkg_root="$1"
  local name
  local feed_name
  local feed_path
  local newest_ipk
  local source_path
  local source_is_newer
  name="$(basename "$pkg_root")"

  if (( release_only == 1 )); then
    if [[ "$name" == test-* ]]; then
      echo "skipping ${name}: test packages are not built for release"
      return 10
    fi
    feed_name="$(feed_name_for_package "$name")"
    feed_path="$(feed_path_for_name "$feed_name")"
    if python3 ./release-packages --is-newer "$pkg_root" "$feed_path"; then
      :
    else
      local status=$?
      if (( status == 1 )); then
        echo "skipping ${name}: control-file version is not newer than release"
        return 10
      fi
      return "$status"
    fi
  elif (( beta_only == 1 )); then
    if [[ "$name" == test-* ]]; then
      echo "skipping ${name}: test packages are not built for beta"
      return 10
    fi
    feed_name="$(feed_name_for_package "$name")"
    if python3 ./release-packages --is-newer "$pkg_root" "$baseline_root/$feed_name"; then
      :
    else
      local status=$?
      if (( status == 1 && all_mode == 1 )); then
        echo "skipping ${name}: base version is not newer than stable"
        return 10
      fi
      if (( status == 1 )); then
        echo "ERROR: ${name} base version must be newer than the stable feed" >&2
        return 1
      fi
      return "$status"
    fi
  elif (( all_mode == 1 )); then

    feed_name="$(feed_name_for_package "$name")"
    feed_path="$(feed_path_for_name "$feed_name")"
    newest_ipk="$(newest_ipk_for_package "$feed_path" "$name")"

    source_is_newer=0
    if [[ -n "$newest_ipk" ]]; then
      local last_source_commit ipk_time
      last_source_commit="$(git -C "$pkg_root" log -1 --format=%ct -- src src-external || true)"
      ipk_time="$(stat -c %Y "$newest_ipk")"
      if [[ -n "$last_source_commit" && "$last_source_commit" -gt "$ipk_time" ]]; then
        source_is_newer=1
      fi
    fi
    for source_path in "$pkg_root/src" "$pkg_root/src-external"; do
      [[ -d "$source_path" ]] || continue
      if [[ -z "$newest_ipk" ]] || folder_has_newer_file_than_ipk "$newest_ipk" "$source_path"; then
        source_is_newer=1
        break
      fi
    done

    if [[ $source_is_newer -eq 0 ]]; then
      echo "skipping ${name}: source is not newer than newest ipk"
      return 10
    fi
  fi

  build_package "$pkg_root"
}

resolve_build_items() {
  declare -i found=0
  local i
  local f

  if [[ ${#cli_build_args[@]} -eq 0 || "${cli_build_args[0]}" == "all" ]]; then
    all_mode=1
    echo "cur dir: $PWD"
    mapfile -t build_items < <(
      for folder in "${folders[@]}"; do
        # A package folder (depth 1 or 2) has a sub folder with Control/control, e.g. pkg/src/CONTROL/control
        find "$folder" -mindepth 4 -maxdepth 5 -type f -name control -ipath '*/control/control' \
          -not -path '*.old/*' -printf '%h/../..\n' | xargs -r -d '\n' realpath | sort -u
      done
    )

		if [[ ${#build_items[@]} -eq 0 ]]; then
			echo "nothing to build"
			exit 0
		fi
		return 0
  fi

  if [[ "${cli_build_args[0]}" == "package" ]]; then
    [[ -n "${cli_build_args[1]-}" ]] || { echo "ERROR: package mode requires a feed path" >&2; return 1; }
    build_feed_index "${cli_build_args[1]}"
    return 0
  fi

  build_items=("${cli_build_args[@]}")

  for i in "${!build_items[@]}"; do
    for f in "${folders[@]}"; do
      if [[ -d "$f/${build_items[$i]}" ]]; then
        build_items[i]="$f/${build_items[$i]}"
        found=1
        break
      fi
    done
    (( found == 1 )) || { echo "invalid package:${build_items[$i]}" >&2; return 1; }
    found=0
  done

}

register_feed_targets() {
  local pkg
  local name
  local feed_name

  for pkg in "${build_items[@]}"; do
    name="$(basename "$pkg")"
    if (( release_only == 1 || beta_only == 1 )) && [[ "$name" == test-* ]]; then
      continue
    fi
    feed_name="$(feed_name_for_package "$name")"
    update_feeds["$feed_name"]="$(feed_path_for_name "$feed_name")"
  done

  local feed
  for feed in "${!update_feeds[@]}"; do
    mkdir -p "${update_feeds[$feed]}"
  done
}

# args: ${1} [in] build path (../.build)
#       ${2} in source path (../addons/project-name)
#       ${3} [out] develop path (../.build/project-name)
develop_source_byref() {
  local build_path="${1}"
  local src_path="${2}"
  local rel_src_path
  local dest_path
  local -n _develop_path="${3}"
  local -a options=()
  shift 3

  if [[ "$src_path" =~ ^(\.\./)+(.*)$ ]]; then
    rel_src_path="${BASH_REMATCH[2]}"
  else
    # Keep source layout under the build path when source is not ../-prefixed.
    rel_src_path="${src_path#./}"
    rel_src_path="${rel_src_path#/}"
  fi

  [[ -n "$rel_src_path" ]] || {
    echo "ERROR: invalid source path: $src_path" >&2
    return 1
  }

  dest_path="$build_path/$rel_src_path"

  options=(--exclude=*.bak --exclude=.git --exclude=*.tmp --exclude=tests/)
  options+=(--exclude=*.old --exclude=.venv/ --exclude='__pycache__/')

  # Exclude directories containing .opkg-ignore
  while IFS= read -r rel_dir; do
    options+=(--exclude="$rel_dir/")
  done < <(
    find "$src_path" -type f -name ".opkg-ignore" | sed "s|^$src_path/||" |
    xargs -r -n1 dirname
  )

  # `-a` enables archive mode (recursive copy and preserve symlinks).
  # Keep links intact so runtime absolute links can be packaged even if referent
  # paths do not exist on the build host.
  # `--mkpath` creates the destination path if it does not already exist.
  # `--delete` keeps the cached staging dir in sync with the source tree.
  echo "  rsync staging: ${src_path} -> ${dest_path}"
	rsync -a --delete --delete-excluded --mkpath "$src_path/" "$dest_path" "${options[@]}" "$@" || return 1
  _develop_path="$dest_path"

  return 0
}

# Appends a UTC prerelease build stamp to the Version field in
# the copied CONTROL/control file. Never touches the source control file.
stamp_prerelease_version() {
  local develop_path="${1}"
  local control_file="${develop_path}/CONTROL/control"
  local stamp="~${build_stamp}"

  [[ -f "$control_file" ]] || { echo "ERROR: control file not found: $control_file" >&2; return 1; }

  if (( beta_only == 1 )); then
    if [[ "$beta_type" == beta ]]; then stamp="~b${build_stamp}"; else stamp="~rc${build_stamp}"; fi
  fi

	sed -i "s/^\(Version:.*\)$/\1${stamp}/" "$control_file"
}

build_package() {

  local pkg_root="${1}"
  local path="${pkg_root}/src"
  local name; name="$(basename "${pkg_root}")"
  local feed_name
  local feed_path
  local feed_path_abs

  feed_name="$(feed_name_for_package "$name")"
  feed_path="$(feed_path_for_name "$feed_name")"
  mkdir -p "$feed_path"
  feed_path_abs="$(cd "$feed_path" && pwd)"

	local build_path="../.build/${name}"

  echo -e "\e[32mbuilding ${name} -> ${feed_path_abs}\e[0m"

  [[ -d "${path}" ]] || { echo "invalid path: ${path}" >&2 ; return 1; }

  local develop_path external_path
  # --update keeps generated outputs (built by build-external in the staging dir)
  # that are newer than the stale copies in the source tree, so they are not rebuilt every run.
  develop_source_byref "$build_path" "$path" develop_path --update || return 1
  # --update could keep a previously stamped control file; always restore it from source.
  if [[ -f "${path}/CONTROL/control" ]]; then
    cp -p "${path}/CONTROL/control" "${develop_path}/CONTROL/control" || return 1
  fi

	if [[ -f "${pkg_root}/src-external/build-external" ]]; then
      develop_source_byref "$build_path" "${pkg_root}/src-external" external_path \
        --exclude=output/ --exclude=build/ || return 1
      echo "  executing ${external_path}/build-external"
      GUI_V2_PLUGIN_COMPILER="$(realpath ../tooling/gui-v2-plugin-compiler.py)" \
        PACKAGE_RELEASE_BUILD="$release_only" \
        "${external_path}/build-external" 3>&1 1>/dev/null || return 1
	fi

  if (( develop_only == 1 || beta_only == 1 )); then
    stamp_prerelease_version "$develop_path" || return 1
  fi

  if (( beta_only == 1 )); then
    python3 ./beta-packages --check "$develop_path/CONTROL/control" "$feed_path" || return 1
  elif (( develop_only == 1 )); then
    local version
    version="$(awk '/^Version:/{print $2}' "$develop_path/CONTROL/control")"
    if compgen -G "$feed_path/${name}_${version}_*.ipk" >/dev/null; then
      echo "ERROR: ${name} ${version} already exists; wait for the next UTC minute" >&2
      return 1
    fi
  fi

  mkdir -p "${develop_path}/data/apps/available/${name}"
  # shellcheck disable=SC2005
  # echo "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" > "${develop_path}/data/apps/${name}/buildtime"
  echo "$(date)" > "${develop_path}/data/apps/available/${name}/buildtime"

  opkg-build -o root -g root "${develop_path}/" "${feed_path_abs}"

}

function create_latest_feed_package() {
	local feed="${1}"
	local feed_path="${feeds_root}/${feed}/vespera"
  local newest_vespera_ipk
  newest_vespera_ipk="$(find "$feed_path" -type f -name 'vespera*.ipk' -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"

  if [ -n "$newest_vespera_ipk" ]; then
			local latest_copy_path="${feed_path}/../vespera-latest.ipk"
      cp -f "$newest_vespera_ipk" "$latest_copy_path"
			echo "Created latest package : ${latest_copy_path}"
	else
			echo "No vespera*.ipk package found under ${feed_path}"
	fi
}
clean_develop_root() {
  [[ -d "$develop_root" ]] || { mkdir -p "$develop_root"; return 0; }

  find "$develop_root" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  mkdir -p "$develop_root"
  echo "cleaned develop feeds folder: ${develop_root}"
}


if (( clean_develop_only == 1 )); then
  acquire_feed_lock
  clean_develop_root
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

if (( release_only == 1 || beta_only == 1 )); then
  command -v opkg-compare-versions >/dev/null 2>&1 || {
    echo "ERROR: opkg-compare-versions not installed" >&2
    exit 1
  }
  if (( release_only == 1 )); then python3 ./release-packages --check-state; fi
fi

acquire_feed_lock
if (( refresh_beta == 0 )); then resolve_build_items; fi

if [[ ${#cli_build_args[@]} -gt 0 && "${cli_build_args[0]}" == "package" ]]; then
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

declare -a build_pids=()
declare -i build_failed=0
declare -i wait_status=0
declare built_items_file
built_items_file="$(mktemp)"
release_workspace=""
beta_workspace=""
cleanup_build() {
  rm -f -- "$built_items_file"
  if [[ -n "$release_workspace" ]]; then
    rm -rf -- "$release_workspace"
  fi
  if [[ -n "$beta_workspace" ]]; then
    rm -rf -- "$beta_workspace"
  fi
}
trap cleanup_build EXIT

if (( release_only == 1 )); then
  mkdir -p ../.build
  release_workspace="$(mktemp -d ../.build/release-feed.XXXXXX)"
  mkdir -p "$release_workspace/feed"
  if [[ -d "$release_root" ]]; then
    rsync -a "$release_root/" "$release_workspace/feed/"
  fi
  release_root="$release_workspace/feed"
fi

if (( beta_only == 1 )); then
  mkdir -p ../.build
  beta_workspace="$(mktemp -d ../.build/beta-feed.XXXXXX)"
  mkdir -p "$beta_workspace/archive" "$beta_workspace/feed"
  release_commit="$(git -C .. rev-parse --verify 'release^{commit}')"
  git -C .. archive "$release_commit" feeds | tar -xf - -C "$beta_workspace/archive"
  baseline_root="$beta_workspace/archive/feeds/release"
  [[ -d "$baseline_root" ]] || { echo "ERROR: release branch has no stable feed" >&2; exit 1; }
  if [[ -d "$beta_workspace/archive/feeds/beta" ]]; then
    rsync -a --exclude='index.html' --exclude='vespera-latest.ipk' "$beta_workspace/archive/feeds/beta/" "$beta_workspace/feed/"
  fi
  if [[ -d "$beta_root" ]]; then
    python3 ./beta-packages --check-notes "$beta_workspace/feed" "$beta_root"
    rsync -a --exclude='index.html' --exclude='vespera-latest.ipk' "$beta_root/" "$beta_workspace/feed/"
  fi
  for feed in addons vespera examples; do
    mkdir -p "$beta_workspace/feed/$feed"
    if [[ -d "$baseline_root/$feed" ]]; then
      rsync -a --exclude='Packages*' --exclude='index.html' --exclude='vespera-latest.ipk' "$baseline_root/$feed/" "$beta_workspace/feed/$feed/"
    fi
    build_feed_index "$beta_workspace/feed/$feed"
  done
  beta_root="$beta_workspace/feed"
fi

register_feed_targets

for pkg in "${build_items[@]}"; do
  (
    build_package_if_needed "$pkg" || exit $?
    echo "$pkg" >> "$built_items_file"
  ) &
  build_pids+=("$!")
done

for pid in "${build_pids[@]}"; do
  if wait "$pid"; then
    :
  else
    wait_status=$?
    if (( wait_status != 10 )); then
      build_failed=1
    fi
  fi
done

(( build_failed == 0 )) || { echo "One or more package builds failed" >&2; exit 1; }

mapfile -t build_items < "$built_items_file"

if [[ ${#build_items[@]} -eq 0 ]]; then
  if (( beta_only == 1 && refresh_beta == 1 )); then
    mkdir -p "${feeds_root}/beta"
    rsync -a --delete "$beta_root/" "${feeds_root}/beta/"
    echo "Beta baseline refreshed from release ${release_commit}; publish feeds/beta."
  fi
  echo "nothing to build"
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

if (( beta_only == 1 )); then
  for feed in addons vespera examples; do
    build_feed_index "$beta_root/$feed"
  done
  [[ -z "$(git -C .. status --porcelain --untracked-files=normal)" ]] || {
    echo "ERROR: working tree changed during beta build; feed not updated" >&2; exit 1;
  }
  [[ "$(git -C .. rev-parse --verify 'HEAD^{commit}')" == "$source_commit" ]] || {
    echo "ERROR: source commit changed during beta build; feed not updated" >&2; exit 1;
  }
  python3 ./beta-packages --notes "$beta_root" "$beta_type" "$build_stamp" "$beta_notes" "$source_commit" "$release_commit" "${build_items[@]}"
  mkdir -p "${feeds_root}/beta"
  rsync -a --delete "$beta_root/" "${feeds_root}/beta/"
  echo "Beta feed ready at ${feeds_root}/beta; copy it to the release checkout for publication."
else
  update_feeds=()
  register_feed_targets
  build_feed_indexes
fi

if ((develop_only == 1)); then
	if echo "${build_items[@]}" | grep -q "vespera"; then
	  #NOTE not part of feed indexes, this is a direct opkg download.
		create_latest_feed_package develop
	fi
fi

if (( release_only == 1 )); then
  python3 ./release-packages --finish "$release_root" "${build_items[@]}"
fi

cd "$pwd_old" || true
echo "Completed"
