#!/usr/bin/env python3

import argparse
import fcntl
import gzip
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import tarfile
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
FEEDS = ROOT / "feeds"
DEVELOP = FEEDS / "develop"
RELEASE = FEEDS / "release"
STAGING = FEEDS / ".release-staging"
BACKUP = FEEDS / ".release-previous"
ARCHIVE = FEEDS / ".release-archive"
LOCK = FEEDS / ".package-operations.lock"
VERSION_RE = re.compile(r"^(?P<base>\d+\.\d+\.\d+)(?:~d\d{6}\.\d{4})?$")
CONTROL_FIELD_RE = re.compile(r"^([A-Za-z0-9][A-Za-z0-9-]*):[ \t]*(.*)$")
DEPENDENCY_RE = re.compile(
    r"^\s*([A-Za-z0-9][A-Za-z0-9+_.-]*)"
    r"(?:\s*\(\s*(<<|<=|=|>=|>>)\s*([^)]+?)\s*\))?\s*$"
)


class PromotionError(RuntimeError):
    pass


def run(command, **kwargs):
    try:
        return subprocess.run(command, check=True, text=True, **kwargs)
    except (OSError, subprocess.CalledProcessError) as error:
        raise PromotionError(f"command failed: {' '.join(map(str, command))}: {error}") from error


def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_control_text(ipk):
    with tempfile.TemporaryDirectory(prefix="ipk-control-") as temp:
        temp_path = Path(temp)
        run(["ar", "x", str(ipk.resolve())], cwd=temp_path, stdout=subprocess.DEVNULL)
        control_archive = temp_path / "control.tar.gz"
        if not control_archive.is_file():
            raise PromotionError(f"missing control.tar.gz in {ipk}")

        with tarfile.open(control_archive, "r:gz") as archive:
            members = archive.getmembers()
            for member in members:
                member_path = Path(member.name)
                if (
                    member_path.is_absolute()
                    or ".." in member_path.parts
                    or not (member.isfile() or member.isdir())
                ):
                    raise PromotionError(f"unsafe control archive member in {ipk}: {member.name}")
            archive.extractall(temp_path / "control", members=members, filter="data")

        control_file = temp_path / "control" / "control"
        if not control_file.is_file():
            raise PromotionError(f"missing control file in {ipk}")
        return control_file.read_text(encoding="utf-8")


def parse_control(text):
    fields = {}
    current_field = None
    for line in text.splitlines():
        if line.startswith((" ", "\t")) and current_field:
            fields[current_field] += "\n" + line[1:]
            continue
        match = CONTROL_FIELD_RE.match(line)
        if match:
            current_field = match.group(1)
            fields[current_field] = match.group(2)
    return fields


def get_package_fields(ipk):
    fields = parse_control(read_control_text(ipk))
    for field in ("Package", "Version", "Architecture"):
        if not fields.get(field):
            raise PromotionError(f"{ipk} has no {field} field")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+_.-]*", fields["Package"]):
        raise PromotionError(f"{ipk} has an invalid Package field")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+_.-]*", fields["Architecture"]):
        raise PromotionError(f"{ipk} has an invalid Architecture field")
    return fields


def release_version(version):
    match = VERSION_RE.fullmatch(version)
    if not match:
        raise PromotionError(
            f"unsupported package version {version!r}; expected MAJOR.MINOR.PATCH "
            "with an optional ~dYYMMDD.HHMM development suffix"
        )
    return match.group("base")


def version_key(version):
    return tuple(int(component) for component in version.split("."))


def opkg_version_satisfies(version, operator, required):
    if not operator:
        return True
    result = subprocess.run(
        ["opkg-compare-versions", version, operator, required],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode not in (0, 1):
        raise PromotionError(
            f"opkg-compare-versions failed for {version} {operator} {required}: {result.stderr.strip()}"
        )
    return result.returncode == 0


def split_dependencies(value, delimiter):
    result = []
    start = 0
    depth = 0
    for index, character in enumerate(value):
        if character == "(":
            depth += 1
        elif character == ")":
            depth -= 1
        elif character == delimiter and depth == 0:
            result.append(value[start:index].strip())
            start = index + 1
    result.append(value[start:].strip())
    return [part for part in result if part]


def parse_dependencies(value):
    groups = []
    for group in split_dependencies(value, ","):
        alternatives = []
        for item in split_dependencies(group, "|"):
            match = DEPENDENCY_RE.fullmatch(item)
            if not match:
                raise PromotionError(f"unsupported dependency expression: {item}")
            alternatives.append((match.group(1), match.group(2), match.group(3)))
        groups.append(alternatives)
    return groups


def package_satisfies(package, requirement):
    name, operator, required_version = requirement
    if package["fields"]["Package"] != name:
        return False
    if not operator:
        return True
    return opkg_version_satisfies(package["fields"]["Version"], operator, required_version)


def dependency_satisfied(alternatives, packages, dependent_arch):
    for requirement in alternatives:
        for package in packages:
            architecture = package["fields"]["Architecture"]
            if architecture not in ("all", dependent_arch):
                continue
            if package_satisfies(package, requirement):
                return True
    return False


def package_record(ipk, feed_name):
    fields = get_package_fields(ipk)
    return {
        "path": ipk,
        "feed": feed_name,
        "fields": fields,
        "version": release_version(fields["Version"]),
    }


def get_feed_packages(feed_root):
    packages = []
    for feed_dir in ("vespera", "addons"):
        path = feed_root / feed_dir
        if not path.is_dir():
            continue
        for ipk in sorted(path.glob("*.ipk")):
            packages.append(package_record(ipk, feed_dir))
    return packages


def load_build_manifest(feed_path, ipk):
    manifest_path = feed_path / ".metadata" / f"{ipk.name}.json"
    if not manifest_path.is_file():
        return None
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise PromotionError(f"invalid build manifest {manifest_path}: {error}") from error
    if not isinstance(manifest, dict):
        raise PromotionError(f"build manifest is not a JSON object: {manifest_path}")
    if manifest.get("filename") != ipk.name or manifest.get("sha256") != sha256(ipk):
        raise PromotionError(f"build manifest does not match package artifact: {ipk}")
    fields = get_package_fields(ipk)
    if (
        manifest.get("package") != fields["Package"]
        or manifest.get("architecture") != fields["Architecture"]
        or manifest.get("source_version") != fields["Version"]
        or not isinstance(manifest.get("source_commit"), str)
        or not re.fullmatch(r"[0-9a-f]{40,64}", manifest.get("source_commit", ""))
        or not isinstance(manifest.get("source_dirty"), bool)
    ):
        raise PromotionError(f"build manifest metadata does not match package artifact: {ipk}")
    return manifest


def get_candidates(feed_names):
    candidates = []
    skipped = []
    for feed_name in feed_names:
        feed_path = DEVELOP / feed_name
        if not feed_path.is_dir():
            continue
        by_package = {}
        for ipk in sorted(feed_path.glob("*.ipk")):
            try:
                fields = get_package_fields(ipk)
                version = release_version(fields["Version"])
            except PromotionError as error:
                skipped.append((ipk.name, str(error)))
                continue
            by_package.setdefault(fields["Package"], []).append(
                {"path": ipk, "fields": fields, "version": version}
            )

        for package_name, artifacts in sorted(by_package.items()):
            newest_key = max(version_key(item["version"]) for item in artifacts)
            newest = [item for item in artifacts if version_key(item["version"]) == newest_key]
            by_architecture = {}
            for item in newest:
                architecture = item["fields"]["Architecture"]
                current = by_architecture.get(architecture)
                if current is None or opkg_version_satisfies(
                    item["fields"]["Version"], ">>", current["fields"]["Version"]
                ):
                    by_architecture[architecture] = item
            newest = list(by_architecture.values())
            manifests = [load_build_manifest(feed_path, item["path"]) for item in newest]
            if any(manifest is None for manifest in manifests):
                skipped.extend(
                    (item["path"].name, "missing build provenance; rebuild the package")
                    for item, manifest in zip(newest, manifests)
                    if manifest is None
                )
                continue
            if any(manifest["source_dirty"] for manifest in manifests):
                skipped.extend(
                    (item["path"].name, "package source tree was dirty; rebuild from a clean commit")
                    for item in newest
                )
                continue
            for item, manifest in zip(newest, manifests):
                item["manifest"] = manifest
                item["feed"] = feed_name
            candidates.extend(newest)
    return candidates, skipped


def create_release_ipk(source_ipk, release_version_value, output_path):
    with tempfile.TemporaryDirectory(prefix="ipk-release-") as temp:
        temp_path = Path(temp)
        run(["ar", "x", str(source_ipk.resolve())], cwd=temp_path, stdout=subprocess.DEVNULL)

        control_archive = temp_path / "control.tar.gz"
        with tarfile.open(control_archive, "r:gz") as archive:
            members = archive.getmembers()
            for member in members:
                member_path = Path(member.name)
                if (
                    member_path.is_absolute()
                    or ".." in member_path.parts
                    or not (member.isfile() or member.isdir())
                ):
                    raise PromotionError(
                        f"unsafe control archive member in {source_ipk}: {member.name}"
                    )
            control_dir = temp_path / "control"
            control_dir.mkdir()
            archive.extractall(control_dir, members=members, filter="data")

        control_file = control_dir / "control"
        if not control_file.is_file():
            raise PromotionError(f"missing control file in {source_ipk}")
        text = control_file.read_text(encoding="utf-8")
        updated_text, count = re.subn(
            r"(?m)^Version:[ \t]*[^\r\n]+",
            f"Version: {release_version_value}",
            text,
        )
        if count != 1:
            raise PromotionError(f"expected one Version field in {source_ipk}, found {count}")
        control_file.write_text(updated_text, encoding="utf-8")

        updated_control_archive = temp_path / "control.tar.gz.new"
        run(
            ["tar", "-czf", str(updated_control_archive), "-C", str(control_dir), "."],
            stdout=subprocess.DEVNULL,
        )
        shutil.move(updated_control_archive, control_archive)

        output_path.parent.mkdir(parents=True, exist_ok=True)
        package_file = temp_path / output_path.name
        run(
            [
                "ar",
                "cr",
                str(package_file),
                "debian-binary",
                "control.tar.gz",
                "data.tar.gz",
            ],
            cwd=temp_path,
            stdout=subprocess.DEVNULL,
        )
        run(["ar", "t", str(package_file)], stdout=subprocess.DEVNULL)
        shutil.copy2(package_file, output_path)


def group_packages(packages):
    groups = {}
    for package in packages:
        fields = package["fields"]
        key = (package["feed"], fields["Package"], package["version"])
        groups.setdefault(key, []).append(package)
    return groups


def validate_dependencies(packages):
    for package in packages:
        fields = package["fields"]
        for alternatives in parse_dependencies(fields.get("Depends", "")):
            if not dependency_satisfied(alternatives, packages, fields["Architecture"]):
                expression = " | ".join(
                    name + (f" ({operator} {version})" if operator else "")
                    for name, operator, version in alternatives
                )
                raise PromotionError(
                    f"{fields['Package']} {fields['Version']} has unsatisfied dependency: {expression}"
                )


def apply_retention(packages, retention, selected_feeds=("vespera", "addons")):
    all_packages = list(packages)
    groups = group_packages(all_packages)
    keep = {key for key in groups if key[0] not in selected_feeds}
    versions_by_package = {}
    for feed, name, version in groups:
        if feed in selected_feeds:
            versions_by_package.setdefault((feed, name), set()).add(version)
    for package_key, versions in versions_by_package.items():
        newest = sorted(versions, key=version_key, reverse=True)[:retention]
        for version in newest:
            keep.add((*package_key, version))

    kept = [package for package in all_packages if (
        package["feed"],
        package["fields"]["Package"],
        package["version"],
    ) in keep]

    while True:
        unresolved = []
        for package in kept:
            fields = package["fields"]
            for alternatives in parse_dependencies(fields.get("Depends", "")):
                if not dependency_satisfied(alternatives, kept, fields["Architecture"]):
                    unresolved.append((package, alternatives))
        if not unresolved:
            break

        added_group = False
        for dependent, alternatives in unresolved:
            satisfying = [
                candidate
                for candidate in all_packages
                if candidate not in kept
                and candidate["fields"]["Architecture"] in (
                    "all",
                    dependent["fields"]["Architecture"],
                )
                and any(package_satisfies(candidate, req) for req in alternatives)
            ]
            if not satisfying:
                names = " | ".join(item[0] for item in alternatives)
                raise PromotionError(
                    f"{dependent['fields']['Package']} {dependent['fields']['Version']} "
                    f"requires unavailable dependency: {names}"
                )
            chosen = None
            for requirement in alternatives:
                matches = [item for item in satisfying if package_satisfies(item, requirement)]
                if matches:
                    chosen = max(matches, key=lambda item: version_key(item["version"]))
                    break
            if chosen is None:
                names = " | ".join(item[0] for item in alternatives)
                raise PromotionError(f"unable to select a dependency version for: {names}")
            chosen_key = (
                chosen["feed"],
                chosen["fields"]["Package"],
                chosen["version"],
            )
            for package in groups[chosen_key]:
                if package not in kept:
                    kept.append(package)
                    added_group = True
        if not added_group:
            raise PromotionError("dependency retention could not produce a valid release feed")

    kept_ids = {id(package) for package in kept}
    pruned = [package for package in all_packages if id(package) not in kept_ids]
    return kept, pruned


def append_json_line(path, record):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, sort_keys=True) + "\n")


def copy_package_to_archive(package):
    fields = package["fields"]
    destination = (
        ARCHIVE
        / package["feed"]
        / fields["Package"]
        / package["path"].name
    )
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if sha256(destination) != sha256(package["path"]):
            raise PromotionError(f"release archive collision for {destination.name}")
        return
    shutil.copy2(package["path"], destination)


def source_is_dirty(package_root):
    status = run(
        ["git", "-C", str(package_root), "status", "--porcelain", "--untracked-files=normal", "--", "src", "src-external"],
        stdout=subprocess.PIPE,
    ).stdout
    return bool(status.strip())


def build_needs_refresh(package_root, feed_path, ipk_name):
    """True if the IPK's provenance is missing, dirty, or predates the latest source commit."""
    manifest_path = Path(feed_path) / ".metadata" / f"{ipk_name}.json"
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        if manifest.get("source_dirty") is not False:
            return True
        built_commit = manifest["source_commit"]
    except (OSError, KeyError, json.JSONDecodeError):
        return True
    last = run(
        ["git", "-C", str(package_root), "log", "-1", "--format=%H", "--", "src", "src-external"],
        stdout=subprocess.PIPE,
    ).stdout.strip()
    if not last:
        return False
    result = subprocess.run(
        ["git", "-C", str(package_root), "merge-base", "--is-ancestor", last, built_commit],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    return result.returncode != 0


def write_build_manifest(package_root, feed_path, source_dirty=None):
    package_root = Path(package_root).resolve()
    feed_path = Path(feed_path).resolve()
    package_name = package_root.name
    artifacts = []
    for ipk in sorted(feed_path.glob(f"{package_name}_*.ipk")):
        fields = get_package_fields(ipk)
        if fields["Package"] == package_name:
            artifacts.append((ipk, fields))
    if not artifacts:
        raise PromotionError(f"no built IPK found for {package_name} in {feed_path}")
    artifacts = [max(artifacts, key=lambda item: item[0].stat().st_mtime_ns)]

    source_commit = run(
        ["git", "-C", str(package_root), "rev-parse", "HEAD"],
        stdout=subprocess.PIPE,
    ).stdout.strip()
    if source_dirty is None:
        source_dirty = source_is_dirty(package_root)
    metadata_dir = feed_path / ".metadata"
    metadata_dir.mkdir(parents=True, exist_ok=True)

    for ipk, fields in artifacts:
        manifest = {
            "architecture": fields["Architecture"],
            "filename": ipk.name,
            "package": fields["Package"],
            "sha256": sha256(ipk),
            "source_commit": source_commit,
            "source_dirty": source_dirty,
            "source_version": fields["Version"],
        }
        manifest_path = metadata_dir / f"{ipk.name}.json"
        temp_path = manifest_path.with_suffix(".json.tmp")
        temp_path.write_text(json.dumps(manifest, sort_keys=True, indent=2) + "\n", encoding="utf-8")
        os.replace(temp_path, manifest_path)


def write_multi_version_index(path):
    # opkg-make-index keeps only the newest version of each package, so index each
    # IPK on its own and concatenate the stanzas to keep every retained version.
    stanzas = []
    for ipk in sorted(path.glob("*.ipk")):
        with tempfile.TemporaryDirectory(prefix="ipk-index-") as temp:
            temp_path = Path(temp)
            shutil.copy2(ipk, temp_path / ipk.name)
            result = run(["opkg-make-index", "./"], cwd=temp_path, stdout=subprocess.PIPE)
            text = result.stdout.strip()
        if not text:
            raise PromotionError(f"no index entry produced for {ipk.name}")
        stanzas.append(text)
    for stale in ("Packages", "Packages.gz", "Packages.stamps"):
        (path / stale).unlink(missing_ok=True)
    content = "\n\n".join(stanzas) + "\n\n"
    (path / "Packages").write_text(content, encoding="utf-8")
    (path / "Packages.gz").write_bytes(gzip.compress(content.encode("utf-8"), mtime=0))


def build_indexes(feed_root, feed_names):
    for feed_name in feed_names:
        path = feed_root / feed_name
        if not path.is_dir() or not list(path.glob("*.ipk")):
            continue
        write_multi_version_index(path)
        packages_file = path / "Packages"
        compressed_file = path / "Packages.gz"
        if not packages_file.is_file() or not compressed_file.is_file():
            raise PromotionError(f"feed indexes were not created in {path}")
        package_index = packages_file.read_text(encoding="utf-8")
        if gzip.decompress(compressed_file.read_bytes()).decode("utf-8") != package_index:
            raise PromotionError(f"compressed feed index does not match Packages in {path}")
        missing = [ipk.name for ipk in path.glob("*.ipk") if ipk.name not in package_index]
        if missing:
            raise PromotionError(f"feed index omits package files in {path}: {', '.join(missing)}")


def recover_previous_publish():
    if BACKUP.exists() and not RELEASE.exists():
        os.replace(BACKUP, RELEASE)
    elif BACKUP.exists():
        shutil.rmtree(BACKUP)


def publish_staging():
    recover_previous_publish()
    if RELEASE.exists():
        os.replace(RELEASE, BACKUP)
    try:
        os.replace(STAGING, RELEASE)
    except OSError:
        if BACKUP.exists() and not RELEASE.exists():
            os.replace(BACKUP, RELEASE)
        raise
    if BACKUP.exists():
        shutil.rmtree(BACKUP)


def validate_promotion_git_state():
    git = ["git", "-C", str(ROOT)]
    branch = run(
        git + ["branch", "--show-current"], stdout=subprocess.PIPE
    ).stdout.strip()
    if branch != "release":
        raise PromotionError(
            f"promotion requires the release branch (current: {branch or 'detached HEAD'})"
        )

    status = run(
        git + ["status", "--porcelain", "--untracked-files=normal"],
        stdout=subprocess.PIPE,
    ).stdout
    if status:
        raise PromotionError(
            "promotion requires a clean working tree; commit or otherwise resolve "
            "tracked and untracked changes before continuing"
        )

    run(
        git + [
            "fetch", "--no-tags", "--no-write-fetch-head", "origin",
            "+refs/heads/develop:refs/remotes/origin/develop",
        ],
        stdout=subprocess.PIPE,
    )
    commits = {}
    for label, ref in (
        ("release", "refs/heads/release"),
        ("develop", "refs/heads/develop"),
        ("origin/develop", "refs/remotes/origin/develop"),
    ):
        commits[label] = run(
            git + ["rev-parse", "--verify", f"{ref}^{{commit}}"],
            stdout=subprocess.PIPE,
        ).stdout.strip()

    if commits["develop"] != commits["origin/develop"]:
        raise PromotionError(
            "local develop does not match origin/develop; synchronize and push "
            "develop before promoting"
        )
    if commits["release"] != commits["develop"]:
        raise PromotionError(
            "release and develop must point to the same commit; synchronize "
            "the branches before promoting"
        )


def prepare_release_tags(promote_items):
    git = ["git", "-C", str(ROOT)]
    run(
        git + [
            "fetch", "--no-tags", "--no-write-fetch-head", "origin",
            "+refs/heads/release:refs/remotes/origin/release",
        ],
        stdout=subprocess.PIPE,
    )
    ancestry = subprocess.run(
        git + ["merge-base", "--is-ancestor", "refs/remotes/origin/release", "HEAD"]
    )
    if ancestry.returncode == 1:
        raise PromotionError("origin/release is not an ancestor of release; synchronize it before applying")
    if ancestry.returncode != 0:
        raise PromotionError("could not compare origin/release with release")

    for identity in ("GIT_AUTHOR_IDENT", "GIT_COMMITTER_IDENT"):
        run(git + ["var", identity], stdout=subprocess.PIPE)

    remote = run(
        git + ["ls-remote", "--refs", "--tags", "origin"], stdout=subprocess.PIPE
    ).stdout
    remote_tags = {line.split("\t", 1)[1].removeprefix("refs/tags/") for line in remote.splitlines()}
    local_tags = set(run(git + ["tag", "--list"], stdout=subprocess.PIPE).stdout.splitlines())
    existing = local_tags | remote_tags

    def conflicts(name):
        return any(
            tag == name or tag.startswith(name + "/") or name.startswith(tag + "/")
            for tag in existing
        )

    base = time.strftime("release-%Y.%m", time.gmtime())
    snapshot = base
    suffix = 2
    while conflicts(snapshot):
        snapshot = f"{base}.{suffix}"
        suffix += 1

    tags = [(snapshot, f"Release {snapshot.removeprefix('release-')}")]
    existing.add(snapshot)
    packages = sorted({(item["fields"]["Package"], item["version"]) for item in promote_items})
    for name, version in packages:
        tag = f"{name}/v{version}"
        run(git + ["check-ref-format", f"refs/tags/{tag}"], stdout=subprocess.PIPE)
        if conflicts(tag):
            raise PromotionError(f"release tag {tag} already exists or conflicts with an existing tag")
        existing.add(tag)
        tags.append((tag, f"{name} v{version}"))
    return tags


def commit_and_push_release(tags):
    git = ["git", "-C", str(ROOT)]
    paths = [str(path.relative_to(ROOT)) for path in (RELEASE, ARCHIVE) if path.exists()]
    try:
        run(git + ["add", "-A", "--", *paths])
        run(git + [
            "commit", "-m", f"Promote packages: {tags[0][0]}",
            "-m", "Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>",
        ])
        for name, message in tags:
            run(git + ["tag", "-a", name, "-m", message])
    except PromotionError as error:
        tag_list = ", ".join(name for name, _ in tags)
        raise PromotionError(
            f"{error}. Release files may have been published locally, staged or committed. "
            f"Inspect git status and HEAD; intended tags: {tag_list}. "
            "Resolve the error before creating any missing tags and pushing."
        ) from error

    refspecs = ["refs/heads/release:refs/heads/release"] + [
        f"refs/tags/{name}:refs/tags/{name}" for name, _ in tags
    ]
    command = git + ["push", "--atomic", "origin", *refspecs]
    try:
        run(command)
    except PromotionError as error:
        retry = shlex.join(["git", "push", "--atomic", "origin", *refspecs])
        raise PromotionError(
            f"{error}. The release commit and tags remain local. Verify the remote "
            f"state, then retry from the repository root with: {retry}"
        ) from error
    print(f"Pushed release and tags: {', '.join(name for name, _ in tags)}")


def promote(feed_selection, apply):
    feed_names = ("vespera", "addons") if feed_selection == "all" else (feed_selection,)
    retention = int(os.environ.get("VESPERA_RELEASE_RETENTION", "3"))
    if retention < 1:
        raise PromotionError("VESPERA_RELEASE_RETENTION must be at least 1")
    for tool in ("ar", "tar", "opkg-make-index", "opkg-compare-versions"):
        if shutil.which(tool) is None:
            raise PromotionError(f"required command not found: {tool}")

    with LOCK.open("a") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        validate_promotion_git_state()
        recover_previous_publish()
        candidates, skipped = get_candidates(feed_names)
        current_packages = get_feed_packages(RELEASE)
        staged_root = STAGING if apply else Path(tempfile.mkdtemp(prefix="release-staging-"))
        try:
            if staged_root.exists():
                shutil.rmtree(staged_root)
            if RELEASE.exists():
                shutil.copytree(RELEASE, staged_root)
            else:
                staged_root.mkdir(parents=True)

            existing_by_name = {}
            for package in current_packages:
                name = package["fields"]["Package"]
                existing_by_name.setdefault(name, []).append(package)

            promote_items = []
            for candidate in candidates:
                fields = candidate["fields"]
                name = fields["Package"]
                candidate_version = candidate["version"]
                released = existing_by_name.get(name, [])
                latest_version = max(
                    (version_key(item["version"]) for item in released),
                    default=None,
                )
                if latest_version is not None and version_key(candidate_version) <= latest_version:
                    latest_text = ".".join(map(str, latest_version))
                    skipped.append((candidate["path"].name, f"release {latest_text} is already current or newer"))
                    continue
                promote_items.append(candidate)

            planned = list(current_packages)
            for candidate in promote_items:
                fields = candidate["fields"]
                output_name = (
                    f"{fields['Package']}_{candidate['version']}_{fields['Architecture']}.ipk"
                )
                output_path = staged_root / candidate["feed"] / output_name
                if apply:
                    create_release_ipk(candidate["path"], candidate["version"], output_path)
                planned.append(
                    {
                        "path": output_path,
                        "feed": candidate["feed"],
                        "fields": {
                            **fields,
                            "Version": candidate["version"],
                        },
                        "version": candidate["version"],
                    }
                )

            _, pruned = apply_retention(planned, retention, feed_names)
            print("Release promotion plan:")
            for candidate in promote_items:
                fields = candidate["fields"]
                print(
                    f"  PROMOTE: {fields['Package']} {candidate['version']} "
                    f"({fields['Architecture']})"
                )
            for filename, reason in skipped:
                print(f"  SKIP: {filename} ({reason})")
            for package in pruned:
                print(
                    f"  PRUNE: {package['fields']['Package']} {package['version']} "
                    f"({package['fields']['Architecture']})"
                )
            if not promote_items and not pruned:
                print("  No release changes.")

            if not apply:
                return
            if not promote_items and not pruned:
                for package in current_packages:
                    copy_package_to_archive(package)
                return

            tags = prepare_release_tags(promote_items)
            for package in pruned:
                if package["path"].exists():
                    copy_package_to_archive(package)
                staged_package = staged_root / package["feed"] / package["path"].name
                if staged_package.exists():
                    staged_package.unlink()

            for package in promote_items:
                fields = package["fields"]
                output_name = (
                    f"{fields['Package']}_{package['version']}_{fields['Architecture']}.ipk"
                )
                staged_package = staged_root / package["feed"] / output_name
                if not staged_package.is_file():
                    raise PromotionError(f"staged package missing: {staged_package}")
                archive_record = {
                    "architecture": fields["Architecture"],
                    "filename": output_name,
                    "package": fields["Package"],
                    "previous_version": max(
                        (
                            item["version"]
                            for item in existing_by_name.get(fields["Package"], [])
                        ),
                        key=version_key,
                        default=None,
                    ),
                    "release_sha256": sha256(staged_package),
                    "release_version": package["version"],
                    "source_commit": package["manifest"]["source_commit"],
                    "source_dirty": package["manifest"]["source_dirty"],
                    "source_sha256": package["manifest"]["sha256"],
                    "source_version": fields["Version"],
                    "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                }
                append_json_line(
                    staged_root / ".promotion-manifest.jsonl",
                    archive_record,
                )

            build_indexes(staged_root, feed_names)
            final_packages = []
            for feed_name in ("vespera", "addons"):
                feed_path = staged_root / feed_name
                if feed_path.is_dir():
                    final_packages.extend(
                        package_record(path, feed_name)
                        for path in sorted(feed_path.glob("*.ipk"))
                    )
            validate_dependencies(final_packages)
            publish_staging()
            try:
                for package in get_feed_packages(RELEASE):
                    copy_package_to_archive(package)
            except (PromotionError, OSError) as error:
                raise PromotionError(
                    f"release feeds were published locally, but archiving failed: {error}. "
                    "Inspect the release and archive before completing the operation."
                ) from error
            print("Published staged release feeds.")
            commit_and_push_release(tags)
        finally:
            if not apply and staged_root.exists():
                shutil.rmtree(staged_root)
            elif apply and staged_root.exists():
                shutil.rmtree(staged_root)


def main():
    parser = argparse.ArgumentParser(description="Build provenance and promote IPKs into release feeds.")
    parser.add_argument("--record-build", nargs=2, metavar=("PACKAGE_ROOT", "FEED_PATH"))
    parser.add_argument("--source-dirty", choices=("true", "false"), help="Dirty state captured before the build ran.")
    parser.add_argument("--check-dirty", metavar="PACKAGE_ROOT", help="Print true/false for package source dirtiness.")
    parser.add_argument("--needs-refresh", nargs=3, metavar=("PACKAGE_ROOT", "FEED_PATH", "IPK_NAME"))
    parser.add_argument("--promote", choices=("all", "vespera", "addons"))
    parser.add_argument("--apply", action="store_true", help="Publish the promotion plan.")
    args = parser.parse_args()

    try:
        if args.check_dirty:
            print("true" if source_is_dirty(args.check_dirty) else "false")
            return 0
        if args.needs_refresh:
            return 0 if build_needs_refresh(*args.needs_refresh) else 1
        if args.record_build:
            if args.promote or args.apply:
                raise PromotionError("--record-build cannot be combined with promotion options")
            dirty = None if args.source_dirty is None else args.source_dirty == "true"
            write_build_manifest(*args.record_build, source_dirty=dirty)
            return 0
        if not args.promote:
            raise PromotionError("specify --record-build or --promote")
        promote(args.promote, args.apply)
    except (PromotionError, OSError, ValueError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
