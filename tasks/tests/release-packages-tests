#!/usr/bin/env bash

set -o nounset

this_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$this_path/../../scripts/libs/test-lib"

test_release_packages_python_suite_runs_successfully() {
  python3 "$this_path/test_release_packages.py"
  local status=$?
  assert_eq 0 "$status"
}

if [[ "${0:-}" == "${BASH_SOURCE[0]}" ]]; then
  test_runner_all --summary "$0" ""
fi
